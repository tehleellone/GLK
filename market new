// ══════════════════════════════════════════════════════════════════
class GlkValueListFilter{
  init(params){
    this.params=params;
    this.colDef=params.colDef;
    this.selected=new Set();
    this.gui=document.createElement('div');
    this.gui.className='glk-ag-filter';
    this.gui.style.cssText='padding:8px;min-width:190px;max-height:240px;overflow:auto;background:var(--bg-card);color:var(--t1);';
    this.search=document.createElement('input');
    this.search.placeholder='Search values...';
    this.search.style.cssText='width:100%;margin-bottom:6px;padding:5px 8px;border:1px solid var(--border);border-radius:6px;background:var(--bg-input);color:var(--t1);font-size:12px;box-sizing:border-box;';
    this.list=document.createElement('div');
    this.actions=document.createElement('div');
    this.actions.style.cssText='display:flex;gap:6px;margin-top:8px;';
    const btnReset=document.createElement('button');
    btnReset.textContent='Reset';
    btnReset.style.cssText='flex:1;padding:4px;border-radius:6px;border:1px solid var(--border);background:var(--bg-secondary);color:var(--t1);cursor:pointer;font-size:11px;font-weight:700;';
    btnReset.onclick=()=>{this.selected.clear();this.renderList();this.params.filterChangedCallback();};
    this.actions.appendChild(btnReset);
    this.gui.appendChild(this.search);
    this.gui.appendChild(this.list);
    this.gui.appendChild(this.actions);
    this.search.addEventListener('input',()=>this.renderList());
    this.renderList();
  }
  cellVal(row){
    const cd=this.colDef,p={data:row,colDef:cd,api:this.params.api,column:this.params.column};
    if(cd.filterValueGetter) return cd.filterValueGetter(p);
    if(cd.valueGetter) return cd.valueGetter(p);
    if(cd.field) return row[cd.field];
    return null;
  }
  cellStr(row){
    const v=this.cellVal(row);
    if(v==null||v==='') return '—';
    return String(v);
  }
  getValues(){
    const vals=[];
    this.params.api.forEachNode(function(n){
      if(!n.data) return;
      const s=this.cellStr(n.data);
      if(s&&s!=='—') vals.push(s);
    }.bind(this));
    return [...new Set(vals)].sort();
  }
  renderList(){
    const q=this.search.value.toLowerCase();
    const vals=this.getValues().filter(function(v){return v.toLowerCase().includes(q);});
    const self=this;
    this.list.innerHTML=vals.map(function(v){
      const esc=v.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
      return '<label style="display:flex;align-items:center;gap:6px;padding:4px 0;cursor:pointer;font-size:12px;"><input type="checkbox" data-v="'+esc+'"'+(self.selected.has(v)?' checked':'')+'><span>'+esc+'</span></label>';
    }).join('')||(vals.length?'':'<div style="font-size:11px;color:var(--t3);padding:4px 0;">No values</div>');
    this.list.querySelectorAll('input[type=checkbox]').forEach(function(inp){
      inp.addEventListener('change',function(){
        const v=inp.getAttribute('data-v');
        if(inp.checked) self.selected.add(v); else self.selected.delete(v);
        self.params.filterChangedCallback();
      });
    });
  }
  getGui(){return this.gui;}
  isFilterActive(){return this.selected.size>0;}
  doesFilterPass(params){
    if(!this.isFilterActive()) return true;
    return this.selected.has(this.cellStr(params.data));
  }
  getModel(){return this.isFilterActive()?{values:[...this.selected]}:null;}
  setModel(model){
    this.selected=new Set(model&&model.values?model.values:[]);
    this.renderList();
  }
}
function glkGridTextVal(p){
  const v=p.data[p.colDef.field];
  return (v==null||v==='')?'—':String(v);
}
function glkGridDateVal(p){ return fmtDate(p.data[p.colDef.field]); }
function glkGridMoneyVal(p){
  const v=p.data[p.colDef.field];
  return (v==null||v==='')?'—':fmt(v);
}
function glkGridNumVal(p){
  const v=p.data[p.colDef.field];
  if(v==null||v==='') return '—';
  return String(v);
}
function glkCol(cfg,kind){
  kind=kind||'text';
  const base={filter:GlkValueListFilter};
  if(kind==='date') base.filterValueGetter=glkGridDateVal;
  else if(kind==='money') base.filterValueGetter=glkGridMoneyVal;
  else if(kind==='num') base.filterValueGetter=glkGridNumVal;
  else base.filterValueGetter=glkGridTextVal;
  return Object.assign(base,cfg);
}

