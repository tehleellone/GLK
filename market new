async function rfExportPDF(opts){
  const JSPDF=(window.jspdf&&window.jspdf.jsPDF)?window.jspdf.jsPDF:(typeof jsPDF!=='undefined'?jsPDF:null);
  if(!JSPDF||typeof html2canvas==='undefined'){ alert('PDF libraries still loading — please try again in a moment.'); return; }
  opts=opts||rfPdfOptsFromTemplate('full')||{summary:true,pipeline:true,scenarios:true,netForecast:true,rollForward:true,charts:[]};
  const chartIds=rfPdfNormalizeChartIds(opts.charts);
  const needsCharts=chartIds.length>0;
  const wasVisible=rfChartsVisible;
  if(needsCharts&&!wasVisible){
    rfChartsVisible=true;
    el('rfChartsSection').style.display='block';
    el('rfChartsToggleText').textContent='Hide Forecast Charts';
  }
  if(needsCharts){
    rfRenderCharts();
    rfResizeAllCharts();
    await new Promise(function(r){ setTimeout(r,700); });
  }
  const chartImages=needsCharts?await rfCaptureChartImages(chartIds):[];
  if(!wasVisible&&needsCharts){
    rfChartsVisible=false;
    el('rfChartsSection').style.display='none';
    el('rfChartsToggleText').textContent='Show Forecast Charts';
  }
  const wrap=document.createElement('div');
  wrap.style.cssText='position:fixed;left:-9999px;top:0;width:900px;';
  wrap.innerHTML=rfBuildPdfReportHtml(opts,chartImages);
  document.body.appendChild(wrap);
  const root=wrap.querySelector('#rfPdfRoot');
  const margin=12;
  try{
    const canvas=await html2canvas(root,{scale:1.35,useCORS:true,backgroundColor:'#ffffff',windowWidth:900});
    const pdf=new JSPDF('p','mm','a4');
    rfPdfAddCanvasPages(pdf,canvas,margin);
    pdf.save('Revenue_Forecast_'+new Date().toISOString().split('T')[0]+'.pdf');
  }catch(err){
    alert('PDF export failed: '+(err.message||err));
  }finally{
    document.body.removeChild(wrap);
  }
}

