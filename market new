// ── TABLE 2: recurring revenue roll-forward (cascade) — MRC only ─
function rfRenderCascade(){
  const section=el('rfCascadeSection');
  const toolbar=el('rfCascadeToolbar');
  const mrcNote=el('rfCascadeMrcNote');
  const container=el('rfCascadeTables');
  if(!container) return;
  if(rfMetric!=='mrc'){
    if(section) section.style.display='none';
    return;
  }
  if(section) section.style.display='block';
  if(mrcNote) mrcNote.style.display='none';
  const hasScenario=rfHasActiveScenario();
  if(rfCascadeUseScenario&&!hasScenario) rfCascadeUseScenario=false;
  if(toolbar) toolbar.style.display=hasScenario?'flex':'none';
  const srcLabel=el('rfCascadeSourceLabel');
  if(srcLabel){
    if(rfCascadeUseScenario&&hasScenario){
      const blocksPipe=rfBuildCascadeYears(rfActiveBids(),{forcePipeline:true});
      const blocksScen=rfBuildCascadeYears(null,{forcePipeline:false});
      const pipeTotal=blocksPipe.reduce(function(s,b){ return s+(b.footerGrandTotal||0); },0);
      const scenTotal=blocksScen.reduce(function(s,b){ return s+(b.footerGrandTotal||0); },0);
      let src='Source: Scenario net ('+rfNetFormulaText(rfGetBlockEntries())+') · Total '+fmt(scenTotal);
      if(pipeTotal===scenTotal) src+=' — same as pipeline (check block filters overlap your deals)';
      else src+=' (pipeline was '+fmt(pipeTotal)+')';
      srcLabel.textContent=src;
    } else {
      srcLabel.textContent='Source: Pipeline (filtered)';
    }
  }
  rfBindCascadeControls();
  const scenBtn=el('rfCascadeScenarioBtn');
  const scenBtnText=el('rfCascadeScenarioBtnText');
  if(scenBtn){
    scenBtn.classList.toggle('active',!!(rfCascadeUseScenario&&hasScenario));
  }
  if(scenBtnText){
    scenBtnText.textContent=rfCascadeUseScenario&&hasScenario?'Scenario Applied to Roll-Forward':'Apply Scenario to Roll-Forward';
  }
  const scenarioOn=rfCascadeUseScenario&&hasScenario;
  const blocks=rfBuildCascadeYears(null,{forcePipeline:!scenarioOn});
  if(!blocks.length){
    container.innerHTML=(rfActiveBids().length||scenarioOn)
      ? '<div style="padding:1rem;color:var(--t3);">No upcoming years to show — try turning off "Hide past months".</div>'
      : '<div style="padding:1rem;color:var(--t3);">No data matches the current filters.</div>';
    return;
  }
  let html='';
  blocks.forEach(function(block){
    html+='<div class="rf-cascade-block"><div class="rf-cascade-block-title">'+block.year+'</div>';
    html+='<div class="rf-panel"><div class="rf-table-scroll"><table class="rf-table"><thead><tr><th>Cohort</th>';
    block.visibleMonths.forEach(m=>html+='<th>'+MONTH_NAMES[m]+'</th>');
    html+='<th class="rf-total-col">Total</th></tr></thead><tbody>';
    block.rows.forEach(function(row){
      html+='<tr><td>'+row.label+'</td>';
      block.visibleMonths.forEach(function(m){
        const v=row.cells[m];
        const drillM=row.isNew?m:row.origin;
        html+= v ? '<td class="rf-cell-btn" onclick="rfOpenDrilldown(null,'+drillM+',\''+block.year+'\','+(scenarioOn?'true':'false')+')">'+fmt(v)+'</td>' : '<td class="rf-cell-empty">—</td>';
      });
      const rt=row.rowTotal||0;
      if(row.isNew){
        html+= rt ? '<td class="rf-total-col">'+fmt(rt)+'</td></tr>' : '<td class="rf-total-col">—</td></tr>';
      } else {
        html+= rt ? '<td class="rf-total-col rf-cell-btn" onclick="rfOpenDrilldown(null,'+row.origin+',\''+block.year+'\','+(scenarioOn?'true':'false')+')">'+fmt(rt)+'</td></tr>' : '<td class="rf-total-col">—</td></tr>';
      }
    });
    html+='</tbody><tfoot><tr><td>'+block.totalLabel+'</td>';
    block.visibleMonths.forEach(function(m){
      html+='<td>'+(block.footerColTotals[m]?fmt(block.footerColTotals[m]):'—')+'</td>';
    });
    html+='<td class="rf-total-col">'+fmt(block.footerGrandTotal||0)+'</td></tr></tfoot></table></div></div></div>';
  });
  container.innerHTML=html;
}

