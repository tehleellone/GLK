// ── data helpers ─────────────────────────────────────────────────
// Table 1 & 2 both key off Expected Activation directly; the cascade (Table 2)
// already models "billed the month after activation" via its origin+1 roll-forward.
function rfGetYear(bid){ if(!bid.expectedActivation) return null; const d=new Date(bid.expectedActivation); return isNaN(d)?null:String(d.getFullYear()); }
function rfGetMonthIdx(bid){ if(!bid.expectedActivation) return null; const d=new Date(bid.expectedActivation); return isNaN(d)?null:d.getMonth(); }
function probToFraction(p){ if(!p) return 0; const n=parseFloat(p); return isNaN(n)?0:n/100; }
function rfGetBaseBids(){
  return ALL_BIDS.filter(b=>b.expectedActivation && !isNaN(new Date(b.expectedActivation)));
}
function rfGetFilterVals(fd){
  const base=rfGetBaseBids();
  if(fd.field==='_rfyear') return [...new Set(base.map(rfGetYear).filter(Boolean))].sort();
  if(fd.field==='closureProb') return PROB_ORDER.filter(p=>base.some(b=>b.closureProb===p));
  return [...new Set(base.map(b=>b[fd.field]).filter(v=>v&&v!=='—'))].sort();
}
function rfApplyUiFilters(bids){
  const checks={};
  RF_FILTER_DEFS.forEach(fd=>{ checks[fd.key]=getChecked(fd.key); });
  return bids.filter(function(b){
    for(const fd of RF_FILTER_DEFS){
      const vals=checks[fd.key]; if(!vals.length) continue;
      const bv=fd.field==='_rfyear'?rfGetYear(b):b[fd.field];
      if(!vals.includes(bv)) return false;
    }
    return true;
  });
}
function rfVisibleBids(){ return rfApplyUiFilters(rfGetBaseBids()); }
function rfActiveBids(){ return rfVisibleBids().filter(b=>!RF_EXCLUDED.has(b.id)); }
function rfGetCellBids(rowVal,monthIdx,year,includeExcluded,blockId){
  let bids;
  if(blockId){
    const block=RF_EXTRA_BLOCKS.find(function(b){ return b.id===blockId; });
    bids=block?rfGetBlockBids(block):[];
  } else {
    if(rfModalCtx&&rfModalCtx.useScenario&&rfHasActiveScenario()){
      bids=rfGetScenarioNetBidsForMonth(year, monthIdx);
      if(!includeExcluded) bids=bids.filter(function(b){ return !RF_EXCLUDED.has(b.id); });
    } else {
      bids=includeExcluded?rfVisibleBids():rfActiveBids();
    }
  }
  if(rowVal!=null) bids=bids.filter(b=>b[rfRowDim]===rowVal);
  if(monthIdx!=null) bids=bids.filter(b=>rfGetMonthIdx(b)===monthIdx);
  if(year!=null) bids=bids.filter(b=>rfGetYear(b)===year);
  return bids;
}
function rfMetricVal(b){ return rfMetric==='count' ? 1 : num(b[rfMetric]); }
function rfSum(bids){ return bids.reduce((s,b)=>s+rfMetricVal(b),0); }
function rfFmtVal(v){ if(rfMetric==='count') return String(Math.round(v*10)/10); if(rfMetric==='gaPoints'||rfMetric==='gaLines') return fmtGA(v); return fmt(v); }
function rfHasActiveScenario(){
  return RF_EXTRA_BLOCKS.some(function(e){ return rfBlockOp(e.op)==='add'||rfBlockOp(e.op)==='subtract'; });
}
function rfBuildScenarioYearBase(year){
  rfSyncAllBlockFiltersFromDom();
  const base=rfYearBaseMrc(rfActiveBids(), year);
  rfGetBlockEntries().forEach(function(e){
    const op=rfBlockOp(e.op||e.block.op);
    if(op==='none') return;
    const blockBase=rfYearBaseMrc(rfGetBlockBids(e.block), year);
    for(let m=0;m<12;m++){
      if(op==='subtract') base[m]=Math.max(0,(base[m]||0)-(blockBase[m]||0));
      else if(op==='add') base[m]=(base[m]||0)+(blockBase[m]||0);
    }
  });
  return base;
}
function rfGetScenarioCascadeYears(){
  const yearSet=new Set();
  rfActiveBids().forEach(function(b){ const y=rfGetYear(b); if(y) yearSet.add(y); });
  rfGetBlockEntries().forEach(function(e){
    if(rfBlockOp(e.op||e.block.op)==='none') return;
    rfGetBlockBids(e.block).forEach(function(b){ const y=rfGetYear(b); if(y) yearSet.add(y); });
  });
  return [...yearSet].sort().filter(rfCascadeYearVisible);
}
function rfCascadeYearGrandTotal(bids,year){
  const blocks=rfBuildCascadeYears(bids,{forcePipeline:true});
  const block=blocks.find(function(b){ return String(b.year)===String(year); });
  return block?block.footerGrandTotal||0:0;
}
function rfGetScenarioNetBidsForMonth(year,monthIdx){
  rfSyncAllBlockFiltersFromDom();
  year=year==null?null:String(year);
  let bids=rfActiveBids().filter(function(b){
    if(year!=null&&rfGetYear(b)!==year) return false;
    if(monthIdx!=null&&rfGetMonthIdx(b)!==monthIdx) return false;
    return true;
  });
  const idSet=new Set(bids.map(function(b){ return b.id; }));
  rfGetBlockEntries().forEach(function(e){
    const op=rfBlockOp(e.op||e.block.op);
    if(op==='none') return;
    const blockBids=rfGetBlockBids(e.block).filter(function(b){
      if(year!=null&&rfGetYear(b)!==year) return false;
      if(monthIdx!=null&&rfGetMonthIdx(b)!==monthIdx) return false;
      return true;
    });
    if(op==='subtract'){
      const removeIds=new Set(blockBids.map(function(b){ return b.id; }));
      bids=bids.filter(function(b){ return !removeIds.has(b.id); });
    } else if(op==='add'){
      blockBids.forEach(function(b){
        if(!idSet.has(b.id)){ bids.push(b); idSet.add(b.id); }
      });
    }
  });
  return bids;
}
function rfGetScenarioNetBids(){
  rfSyncAllBlockFiltersFromDom();
  let bids=rfActiveBids().slice();
  const idSet=new Set(bids.map(function(b){ return b.id; }));
  rfGetBlockEntries().forEach(function(e){
    const op=rfBlockOp(e.op||e.block.op);
    if(op==='none') return;
    const blockBids=rfGetBlockBids(e.block);
    if(op==='subtract'){
      const removeIds=new Set(blockBids.map(function(b){ return b.id; }));
      bids=bids.filter(function(b){ return !removeIds.has(b.id); });
    } else if(op==='add'){
      blockBids.forEach(function(b){
        if(!idSet.has(b.id)){ bids.push(b); idSet.add(b.id); }
      });
    }
  });
  return bids;
}
