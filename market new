function rfDownloadFile(content, filename, mime){
  try{
    const payload='\uFEFF'+content;
    const type=mime||'application/vnd.ms-excel;charset=utf-8';
    const blob=new Blob([payload],{type:type});
    if(window.navigator&&typeof window.navigator.msSaveOrOpenBlob==='function'){
      window.navigator.msSaveOrOpenBlob(blob,filename);
      return;
    }
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a');
    a.href=url;
    a.download=filename;
    a.style.display='none';
    document.body.appendChild(a);
    if(typeof a.click==='function') a.click();
    else a.dispatchEvent(new MouseEvent('click',{bubbles:true,cancelable:true,view:window}));
    setTimeout(function(){
      URL.revokeObjectURL(url);
      if(a.parentNode) a.parentNode.removeChild(a);
    },8000);
  }catch(err){
    try{ rfDownloadFileWindowFallback(content); }
    catch(e2){ alert('Download failed: '+(err.message||err)); }
  }
}
function rfDownloadFileWindowFallback(content){
  const w=window.open('','_blank');
  if(!w) throw new Error('Pop-up blocked — allow pop-ups for SharePoint, then try again.');
  w.document.open('text/html','replace');
  w.document.write(content);
  w.document.close();
  w.focus();
}
