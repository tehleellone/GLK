function rfBuildCascadeYears(bids, opts){
  opts=opts||{};
  const useScenario=!opts.forcePipeline&&rfCascadeUseScenario&&rfHasActiveScenario();
  if(useScenario) rfSyncAllBlockFiltersFromDom();
  let years;
  if(useScenario){
    years=rfGetScenarioCascadeYears();
  } else {
    bids=bids||rfActiveBids();
    years=[...new Set(bids.map(rfGetYear).filter(Boolean))].sort().filter(rfCascadeYearVisible);
  }
  const out=[];
  years.forEach(function(year){
    const base=useScenario?rfBuildScenarioYearBase(year):rfYearBaseMrc(bids||rfActiveBids(),year);
    if(!base.some(v=>v)) return;
    const visibleMonths=[];
    for(let m=0;m<12;m++) if(rfCascadeMonthVisible(year,m)) visibleMonths.push(m);
    if(!visibleMonths.length) return;
    const rows=[];
    const newCells={};
    visibleMonths.forEach(function(m){
      if(rfCascadeOriginVisible(year,m)) newCells[m]=base[m];
    });
    let newRowTotal=0;
    visibleMonths.forEach(function(m){ if(newCells[m]) newRowTotal+=newCells[m]; });
    rows.push({label:'New This Month',cells:newCells,isNew:true,origin:null,rowTotal:newRowTotal});
    let footerGrandTotal=0;
    for(let origin=0;origin<11;origin++){
      if(!base[origin]||!rfCascadeOriginVisible(year,origin)) continue;
      const cells={}; let has=false; let rowTotal=0;
      for(let target=origin+1;target<12;target++){
        if(visibleMonths.includes(target)){ cells[target]=base[origin]; has=true; rowTotal+=base[origin]; }
      }
      if(has){
        rows.push({label:MONTH_NAMES[origin]+' cohort',cells:cells,isNew:false,origin:origin,rowTotal:rowTotal});
        footerGrandTotal+=rowTotal;
      }
    }
    const footerColTotals={};
    visibleMonths.forEach(m=>footerColTotals[m]=0);
    for(let origin=0;origin<11;origin++){
      if(!base[origin]||!rfCascadeOriginVisible(year,origin)) continue;
      for(let target=origin+1;target<12;target++){
        if(visibleMonths.includes(target)) footerColTotals[target]+=base[origin];
      }
    }
    out.push({
      year:year,
      visibleMonths:visibleMonths,
      rows:rows,
      footerColTotals:footerColTotals,
      footerGrandTotal:footerGrandTotal,
      totalLabel:rfHidePast?'Remaining Total':'Grand Total'
    });
  });
  return out;
}
