function rfExcelMatrixTable(title, matrix, headerBg, rowTint, showNeg){
  if(!matrix) return rfExcelSectionTitle(title+' (no data)','#999');
  const {visibleMonths,rows,cells,colTotals,rowTotals,grandTotal,rowLabel,totalLabel}=matrix;
  let h=rfExcelSectionTitle(title,headerBg);
  h+='<table class="xtable" cellspacing="0" cellpadding="0" border="1">';
  h+='<tr><th style="background:'+headerBg+';text-align:left;">'+rfEscHtml(rowLabel)+'</th>';
