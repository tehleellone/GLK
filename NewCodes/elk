function spGet(url,cb){
  const xhr=new XMLHttpRequest();
  xhr.open('GET',url,true);
  xhr.timeout=20000;
  xhr.setRequestHeader('Accept','application/json;odata=verbose');
  xhr.onreadystatechange=function(){
    if(xhr.readyState!==4) return;
    if(xhr.status>=200&&xhr.status<300){ try{ cb(null,JSON.parse(xhr.responseText)); }catch(e){ cb(e,null); } }
    else { cb(new Error('HTTP '+xhr.status),null); }
  };
  xhr.onerror=function(){ cb(new Error('Network error'),null); };
  xhr.ontimeout=function(){ cb(new Error('Request timed out'),null); };
  xhr.send();
}
function spEscPath(p){ return String(p||'').replace(/'/g,"''"); }
function spGetRequestDigest(cb){
  var xhr=new XMLHttpRequest();
  xhr.open('POST',SP_SITE+'/_api/contextinfo',true);
  xhr.setRequestHeader('Accept','application/json;odata=verbose');
  xhr.onreadystatechange=function(){
    if(xhr.readyState!==4) return;
    if(xhr.status>=200&&xhr.status<300){
      try{ cb(null,JSON.parse(xhr.responseText).d.GetContextWebInformation.FormDigestValue); }
      catch(e){ cb(e,null); }
    }else cb(new Error('Digest HTTP '+xhr.status),null);
  };
  xhr.onerror=function(){ cb(new Error('Network error'),null); };
  xhr.send();
}
function spPostJson(url,body,digest,cb){
  var xhr=new XMLHttpRequest();
  xhr.open('POST',url,true);
  xhr.setRequestHeader('Accept','application/json;odata=verbose');
  xhr.setRequestHeader('Content-Type','application/json;odata=verbose');
  xhr.setRequestHeader('X-RequestDigest',digest);
  xhr.onreadystatechange=function(){
    if(xhr.readyState!==4) return;
    if(xhr.status>=200&&xhr.status<300){
      try{ cb(null,JSON.parse(xhr.responseText)); }catch(e){ cb(e,null); }
    }else cb(new Error('HTTP '+xhr.status+(xhr.responseText?': '+xhr.responseText.slice(0,120):'')),null);
  };
  xhr.onerror=function(){ cb(new Error('Network error'),null); };
  xhr.send(JSON.stringify(body));
}
function spGetBinary(url,cb){
  var xhr=new XMLHttpRequest();
  xhr.open('GET',url,true);
  xhr.responseType='arraybuffer';
  xhr.onreadystatechange=function(){
    if(xhr.readyState!==4) return;
    if(xhr.status>=200&&xhr.status<300) cb(null,xhr.response);
    else cb(new Error('HTTP '+xhr.status),null);
  };
  xhr.onerror=function(){ cb(new Error('Network error'),null); };
  xhr.send();
}
function spUploadBinary(url,arrayBuffer,digest,cb){
  var xhr=new XMLHttpRequest();
  xhr.open('POST',url,true);
  xhr.setRequestHeader('Accept','application/json;odata=verbose');
  xhr.setRequestHeader('Content-Type','application/octet-stream');
  xhr.setRequestHeader('X-RequestDigest',digest);
  xhr.onreadystatechange=function(){
    if(xhr.readyState!==4) return;
    if(xhr.status>=200&&xhr.status<300){
      try{ cb(null,JSON.parse(xhr.responseText)); }catch(e){ cb(null,{}); }
    }else cb(new Error('Upload HTTP '+xhr.status),null);
  };
  xhr.onerror=function(){ cb(new Error('Network error'),null); };
  xhr.send(arrayBuffer);
}
function spPostEmpty(url,digest,cb){
  var xhr=new XMLHttpRequest();
  xhr.open('POST',url,true);
  xhr.setRequestHeader('Accept','application/json;odata=verbose');
  xhr.setRequestHeader('X-RequestDigest',digest);
  xhr.onreadystatechange=function(){
    if(xhr.readyState!==4) return;
    if(xhr.status>=200&&xhr.status<300) cb(null);
    else if(xhr.status===409||xhr.status===500&&/already exists|duplicate/i.test(xhr.responseText||'')) cb(null);
    else cb(new Error('HTTP '+xhr.status+(xhr.responseText?': '+String(xhr.responseText).slice(0,160):'')),null);
  };
  xhr.onerror=function(){ cb(new Error('Network error'),null); };
  xhr.send();
}
function spUploadMobileReport(arrayBuffer,originalName,cb){
