function mqBidQtgMrc(bid,year,quarter){
  if(!mqActivationQtdForward(bid)) return 0;
  var act=mqParseBidDate(bid.expectedActivation);
  if(!act) return 0;
  var live=mqLiveYearQuarter();
  var qEnd=mqQuarterEndDate(live.year,live.quarter);
  if(act>qEnd) return 0;
  return mqAggregatedRevenueMrc(act,qEnd,num(bid.mrc));
}
function mqBidYtgMrc(bid,year){
  var act=mqParseBidDate(bid.expectedActivation);
  if(!act) return 0;
  var yEnd=mqYearEndDate(year);
  if(act>yEnd) return 0;
  return mqAggregatedRevenueMrc(act,yEnd,num(bid.mrc));
}
function mqBidForwardOtc(bid){
