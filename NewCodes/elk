  var years=[],quarters=[],months=[],weeks=[];
  metas.forEach(function(m){ var ys=String(m.year); if(years.indexOf(ys)<0) years.push(ys); });
  years.sort(function(a,b){return parseInt(b,10)-parseInt(a,10);});
  metas.forEach(function(m){
