      var b=bars[i];
      if(!b||!(b.type==='step'||b.type==='outforecast'||b.type==='gap'||b.type==='over')) return;
      if(bar.base==null||bar.y==null||isNaN(bar.base)||isNaN(bar.y)) return;
      var h=Math.abs(bar.base-bar.y);
