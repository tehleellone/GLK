      if(onBar){
        ctx.fillStyle='#fff';
        ctx.font='bold 10px Inter'; ctx.textAlign='center'; ctx.textBaseline='middle';
        ctx.fillText(lbl,bar.x,top+h/2);
      }else{
        ctx.fillStyle=b.color||MQ_CLR_INFLIGHT[0];
        ctx.font='bold 9px Inter'; ctx.textAlign='center';
        ctx.textBaseline=b.type==='decrease'?'top':'bottom';
        ctx.fillText(lbl,bar.x,b.type==='decrease'?bot+4:top-4);
      }
      if(GLK_MQ_DETAIL_IDX===i){
        ctx.strokeStyle='rgba(99,102,241,.9)'; ctx.lineWidth=2.5;
        ctx.strokeRect(bar.x-(bar.width||14)/2-3,top-3,(bar.width||14)+6,h+6);
      }
      ctx.restore();
    });
  }};
}
function glkMobileQtdSepPlugin(churnSepIdx,c){
  return {id:'mqSep',afterDraw:function(chart){
    if(churnSepIdx<0) return;
    var meta=chart.getDatasetMeta(0);
    if(!meta||!meta.data[churnSepIdx]) return;
    var bar=meta.data[churnSepIdx], ctx=chart.ctx, area=chart.chartArea;
    var x=bar.x-(bar.width||20)*0.55;
    ctx.save(); ctx.strokeStyle='rgba(100,116,139,.55)'; ctx.lineWidth=1.5; ctx.setLineDash([5,5]);
    ctx.beginPath(); ctx.moveTo(x,area.top); ctx.lineTo(x,area.bottom+8); ctx.stroke();
    ctx.restore();
  }};
}
function renderMobileQtdBridge(){
  destroyChart('mobileQtd');
  mqCloseBarDetail();
  mqSyncYtdManualPanel();
  var c=getChartColors();
  var calc=glkMobileQtdCalc();
  var isForward=calc.isForward;
  var periodLbl=mqPeriodShortName(calc.bridgePeriod);
  var periodLong=mqPeriodLongName(calc.bridgePeriod);
  var badge=el('mqTargetBadge');
  if(badge){
    if(isForward){
      badge.textContent='Fixed · '+periodLong+' · MRC + OTC · '+calc.vertical;
    }else{
      var scope=calc.vertical==='GLK Overall'?'GLK Overall':'Vertical: '+calc.vertical;
      var actLbl=mqActualsBarLabel();
      badge.textContent=scope+' · '+actLbl+' '+fmtLines(calc.actualsQtd)+' · Target '+fmtLines(calc.target);
    }
  }
  var sub=el('mqBridgeSubtitle');
  if(sub){
    if(isForward){
      sub.textContent=mqCaseDisplayName(calc.isBest?'best':'worst')+' · '+(calc.isBest?'Proposed + Opportunity':'Proposed only')+' · '+periodLong+' · Won + In-flight · (days÷month days)×MRC + OTC';
    }else{
      var ytdNote=mqIsYtdBridge()?' · YTD Jan–'+((GLK_YTD_META.currentMonth&&GLK_YTD_META.currentMonth.label)||'current month'):'';
      sub.textContent=mqCaseDisplayName(calc.isBest?'best':'worst')+' · '+(calc.isBest?'Proposed + Opportunity':'Proposed only')+
        (mqIsYtdBridge()?(' · YTD '+calc.year+ytdNote+' · Pipeline = Quarter to Go (current month → quarter-end)'):(' · Q'+calc.quarter+' '+calc.year))+
        (mqIsYtdBridge()?'':' · '+mqMetricUnit()+' · Act: current month → quarter-end');
    }
  }
  if(!isForward&&!mqGetActiveReport()){
    var wrap=el('mobileQtdSummaryWrap');
    var chartWrap=el('mqChartWrap');
    var msg='No '+(mqProductFamily==='fixed'?'Fixed Net MRC':'Mobile Net Adds – Lines')+' section in the uploaded GLK report.';
    if(wrap) wrap.innerHTML='<span style="color:#f59e0b;">'+msg+' Re-upload the daily GLK Excel or switch product family.</span>';
    if(chartWrap) chartWrap.innerHTML='<div style="display:flex;align-items:center;justify-content:center;height:340px;color:var(--t3);font-size:.82rem;text-align:center;padding:1rem;">'+msg+'</div>';
    if(badge) badge.textContent='Target: —';
    return;
  }
  var chartWrapReset=el('mqChartWrap');
  if(chartWrapReset&&!chartWrapReset.querySelector('canvas')) chartWrapReset.innerHTML='<canvas id="chartMobileQtd"></canvas><div id="mqVertOnChart"></div>';
  var bars=[],barMeta=[],churnSepIdx=-1;
  var trueCum=0,dispTop=0;
  var scaleMax=Math.max(calc.target,calc.actualsQtd,calc.forecast,1);
  function dispH(v,isPlaceholder,asTile){
    var a=Math.abs(num(v));
    if(isPlaceholder) return Math.max(scaleMax*0.05, 28);
    if(asTile) return Math.max(a, scaleMax*0.07);
    return a;
  }
  function pushBar(b,meta){
    bars.push(b); barMeta.push({label:meta||'',bar:b});
  }
  if(!isForward){
    var actualsLbl=mqActualsBarLabel();
    var actualsVert=(!calc.activeReportLevels.length&&calc.actualsByVertical)?calc.actualsByVertical.map(function(v){return {name:v.name,value:v.actualQtd};}):null;
    trueCum=calc.actualsQtd; dispTop=calc.actualsQtd;
    pushBar({
      value:calc.actualsQtd,trueCum:trueCum,displayStart:0,displayEnd:dispH(calc.actualsQtd,calc.actualsQtd===0),
      color:MQ_CLR_ACTUALS,type:'base',custName:actualsLbl,section:'actuals',bids:[],
      vertBreakdown:actualsVert
    },actualsLbl+' · '+fmtLines(calc.actualsQtd)+(calc.reportScopeMissing?' (vertical not in report!)':''));
    dispTop=dispH(calc.actualsQtd,calc.actualsQtd===0);
    if(calc.gross100!==0){
      trueCum+=calc.gross100;
      var g0s=dispTop,g0e=dispTop+dispH(calc.gross100); dispTop=g0e;
      var wonLbl=mqWonBarLabel(calc);
      pushBar({
        value:calc.gross100,trueCum:trueCum,displayStart:g0s,displayEnd:g0e,color:MQ_CLR_WON,type:'increase',
        custName:wonLbl,section:'won',bids:calc.gross100Bids||[],
        vertBreakdown:(calc.activeReportLevels&&calc.activeReportLevels.length)?null:mqVerticalBreakdown(calc.gross100Bids||[],mqBidMetric)
      },wonLbl+' · '+fmtLines(calc.gross100));
    }
  }else{
    trueCum=0; dispTop=0;
    if(calc.gross100!==0){
      trueCum+=calc.gross100;
      var g0s=dispTop,g0e=dispTop+dispH(calc.gross100); dispTop=g0e;
      var wonLblF=mqWonBarLabel(calc);
      pushBar({
        value:calc.gross100,trueCum:trueCum,displayStart:g0s,displayEnd:g0e,color:MQ_CLR_WON,type:'increase',
        custName:wonLblF,section:'won',bids:calc.gross100Bids||[],
        vertBreakdown:null
      },wonLblF+' · '+fmtLines(calc.gross100));
    }
  }
  calc.grossPool.top.forEach(function(p,i){
    if(!p.value) return;
    trueCum+=p.value;
    var ds=dispTop,de=dispTop+dispH(p.value,false,true); dispTop=de;
    var vHint=mqBridgeShowsVertical(calc)?mqVerticalDisplayHint(p.bids):'';
    var top5Lbl=mqInflightTop5Label();
    pushBar({
      value:p.value,trueCum:trueCum,displayStart:ds,displayEnd:de,
      color:mqPoolBarColor(p.bids),type:'increase',
      custName:p.name,section:'gross',bids:p.bids||[],bracketGroup:'top5gross',bracketLabel:top5Lbl,groupLabel:top5Lbl,
      verticalHint:vHint
    },'Top · '+p.name+' · '+fmtLines(p.value));
  });
  if(calc.grossPool.others!==0){
    trueCum+=calc.grossPool.others;
    var gs=dispTop,ge=dispTop+dispH(calc.grossPool.others); dispTop=ge;
    var othersLbl=mqInflightOthersLabel();
    pushBar({
      value:calc.grossPool.others,trueCum:trueCum,displayStart:gs,displayEnd:ge,color:MQ_CLR_INFLIGHT_OTHERS,type:'increase',
      custName:othersLbl,section:'gross',bids:calc.grossPool.othersBids||[],groupLabel:othersLbl
    },othersLbl+' · '+fmtLines(calc.grossPool.others));
  }
  churnSepIdx=bars.length;
  if(!calc.hasChurn){
    pushBar({
      value:0,trueCum:trueCum,displayStart:dispTop,displayEnd:dispTop+dispH(0,true),
      color:MQ_CLR_EMPTY,type:'empty',
      custName:'No Churn',section:'empty',bids:[],groupLabel:'Churn'
    },'No Churn in pipeline');
  }else{
    calc.churnPool.top.forEach(function(p,i){
      if(!p.value) return;
      trueCum+=p.value;
      var cs=dispTop,ce=dispTop-dispH(Math.abs(p.value),false,true); dispTop=ce;
      var vHintC=mqBridgeShowsVertical(calc)?mqVerticalDisplayHint(p.bids):'';
      pushBar({
        value:p.value,trueCum:trueCum,displayStart:cs,displayEnd:ce,color:mqPoolBarColor(p.bids),type:'decrease',
        custName:p.name,section:'churn',bids:p.bids||[],bracketGroup:'top5churn',bracketLabel:'Top 5 Churn',groupLabel:'Top 5 Churn',
        verticalHint:vHintC
      },'Top Churn · '+p.name+' · '+fmtLines(p.value));
    });
    if(calc.churnPool.others!==0){
      trueCum+=calc.churnPool.others;
      var os=dispTop,oe=dispTop-dispH(Math.abs(calc.churnPool.others),false,true); dispTop=oe;
      pushBar({
        value:calc.churnPool.others,trueCum:trueCum,displayStart:os,displayEnd:oe,color:MQ_CLR_CHURN_OTHERS,type:'decrease',
        custName:'Others Churn',section:'churn',bids:calc.churnPool.othersBids||[],groupLabel:'Others Churn'
      },'Others Churn · '+fmtLines(calc.churnPool.others));
    }
  }
  var fc=calc.forecast;
  var netLbl=isForward?('Total '+periodLong):'Net Forecast';
  pushBar({value:fc,trueCum:fc,displayStart:0,displayEnd:fc,color:MQ_CLR_NET,type:'total',custName:netLbl,section:'outcome'},netLbl+' · '+fmtLines(fc));
  if(!isForward){
    var tgtDisp=calc.target;
    pushBar({value:calc.target,trueCum:calc.target,displayStart:0,displayEnd:tgtDisp,color:MQ_CLR_TARGET,type:'target',custName:'Target',section:'outcome'},'Target · '+fmtLines(calc.target));
    if(calc.target>0){
      if(calc.gap>0){
        var gs2=Math.min(fc,tgtDisp),ge2=Math.max(fc,tgtDisp);
        if(ge2===gs2) ge2=gs2+dispH(calc.gap);
        pushBar({value:calc.gap,trueCum:calc.target,displayStart:gs2,displayEnd:ge2,color:MQ_CLR_GAP,type:'gap',custName:'Gap to Target',section:'outcome'},'Gap · '+fmtLines(calc.gap));
      }else if(calc.growth>0){
        var gs3=tgtDisp,ge3=tgtDisp+dispH(calc.growth);
        pushBar({value:calc.growth,trueCum:calc.target,displayStart:gs3,displayEnd:ge3,color:MQ_CLR_GROWTH,type:'growth',custName:'Growth vs Target',section:'outcome'},'Growth · +'+fmtLines(calc.growth));
      }
    }
  }
  var yMax=Math.max(calc.forecast,isForward?0:calc.target,isForward?0:calc.actualsQtd,1);
  var yMin=0;
  bars.forEach(function(b){
    yMax=Math.max(yMax,b.displayStart,b.displayEnd,Math.abs(b.trueCum||0),Math.abs(b.value));
    yMin=Math.min(yMin,b.displayStart,b.displayEnd);
  });
  yMax*=1.08;
  if(yMin<0) yMin=Math.floor(yMin*1.06);
  var maxNameLen=0;
  bars.forEach(function(b){ maxNameLen=Math.max(maxNameLen,String(b.custName||'').length); });
  var scrollWrap=el('mqBridgeScroll');
  var parentW=scrollWrap?scrollWrap.clientWidth:900;
  var barSlot=Math.max(76,Math.min(104,Math.floor(parentW/Math.max(bars.length,1))));
  if(maxNameLen>14) barSlot=Math.max(barSlot,Math.min(112,maxNameLen*5.5));
  if(bars.length>14) barSlot=Math.max(barSlot,84);
  var minChartW=Math.max(parentW,bars.length*barSlot+48);
  var axisPad=8;
  var chartOuter=el('mqChartOuter');
  var chartWrap=el('mqChartWrap');
  if(chartOuter) chartOuter.style.minWidth=minChartW+'px';
  GLK_MQ_LAST_BAR_SLOT=barSlot;
  GLK_MQ_LAST_CHART_W=minChartW;
  var canvas=el('chartMobileQtd');
  if(!canvas) return;
  canvas.style.cursor='pointer';
  var plugins=[
    glkMobileQtdSectionPlugin(bars),
    glkMobileQtdFlowPlugin(bars),
    glkMobileQtdLabelPlugin(bars),
    glkMobileQtdSepPlugin(churnSepIdx,c)
  ];
  try{
    CHARTS.mobileQtd=new Chart(canvas,{
      type:'bar', plugins:plugins,
      data:{labels:bars.map(function(b){return b.custName||'';}),datasets:[{
        data:bars.map(glkMobileQtdFloatBar),
        backgroundColor:bars.map(function(b){return b.color;}),
        borderColor:bars.map(function(b){
          if(b.type==='total') return '#4338ca';
          if(b.type==='target') return '#155e75';
          if(b.type==='growth') return '#15803d';
          if(b.type==='gap') return '#b91c1c';
          return 'transparent';
        }),
        borderWidth:bars.map(function(b){return (b.type==='total'||b.type==='target'||b.type==='growth'||b.type==='gap')?2:0;}),
        borderRadius:6,borderSkipped:false,
        barPercentage:.82,categoryPercentage:.88,minBarLength:36,maxBarThickness:56
      }]},
      options:{responsive:true,maintainAspectRatio:false,
        layout:{padding:{bottom:axisPad,top:16,left:4,right:8}},
        animation:{duration:0},
        onClick:function(evt,elements){
          if(!elements.length){ mqCloseBarDetail(); return; }
          mqToggleBarDetail(elements[0].index,bars,barMeta);
        },
        interaction:{mode:'index',intersect:false},
        plugins:{legend:{display:false},tooltip:{
          backgroundColor:'rgba(15,10,30,.92)',padding:12,cornerRadius:10,titleFont:{size:12,weight:'700'},bodyFont:{size:11},
          callbacks:{
            title:function(items){var m=barMeta[items[0].dataIndex]; return m?m.label:'';},
            label:function(ctx){return null;},
            afterBody:function(items){
              var b=bars[items[0].dataIndex];
              return b?mqBarTooltipLines(b):[];
            }
          }}},
        scales:{
          x:{ticks:{display:false,color:c.text,font:{size:9,weight:'600'}},grid:{display:false},
            border:{display:true,color:c.grid}},
          y:{min:yMin,max:yMax,ticks:{color:c.text,font:{size:10},callback:function(v){return fmtLines(v);}},grid:{color:c.grid},
            title:{display:true,text:(isForward?('Aggregated Revenue (MRC + OTC)'):mqMetricUnit())+' · '+mqCaseDisplayName(calc.isBest?'best':'worst'),color:c.text,font:{size:9,weight:'600'}}}
        }
      }
    });
  }catch(err){ console.error('[GLK] Mobile QTD chart error:',err); }
  GLK_MQ_LAST_BARS=bars;
  GLK_MQ_LAST_BAR_META=barMeta;
  mqSyncChartLabels(CHARTS.mobileQtd,bars);
  mqRenderBridgeLegend();
  var sum=el('mobileQtdSummaryWrap');
  if(sum){
    if(isForward){
      var wonLblS=mqWonBarLabel(calc);
      sum.innerHTML='<strong>'+mqCaseDisplayName(calc.isBest?'best':'worst')+' · '+periodLong+'</strong> · '+wonLblS+' '+fmtLines(calc.gross100)+
        ' · In-flight Gross '+fmtLines(calc.inflightGross)+
        ' · Churn '+fmtLines(calc.inflightChurn)+
        ' · Total '+fmtLines(calc.forecast)+' · (days÷month days)×MRC + OTC';
    }else{
      var gapTxt=calc.gap>0
        ?'<span style="color:'+MQ_CLR_GAP+';">'+fmtLines(calc.gap)+' short of target</span>'
        :'<span style="color:'+MQ_CLR_GROWTH+';">+'+fmtLines(calc.growth)+' ahead of target</span>';
      var actLbl2=mqActualsBarLabel();
      var ytdWarn='';
      (GLK_YTD_META.warnings||[]).forEach(function(w){
        if(w.type==='no_live_sheet') ytdWarn+=' · <span style="color:#f59e0b;">⚠ '+w.message+'</span>';
        if((w.type==='ytd_target_missing'||w.type==='mobile_q1_missing')&&(!w.product||w.product===mqProductFamily)){
          ytdWarn+=' · <span style="color:#f59e0b;">⚠ '+w.message+'</span>';
        }
      });
      if(mqIsYtdBridge()&&mqProductFamily==='mobile'&&calc.ytdMissing&&calc.ytdMissing.length){
        ytdWarn+=' · <span style="color:#f59e0b;">⚠ Missing: '+calc.ytdMissing.join(', ')+' — enter below</span>';
      }
      if(mqIsYtdBridge()&&mqProductFamily==='mobile'&&calc.activeReportLevels&&calc.activeReportLevels.length){
        ytdWarn+=' · <span style="color:#92400e;">Per-vertical targets: update Net Add Lines › Target in the Excel file</span>';
      }
      if(mqIsYtdBridge()&&mqProductFamily==='fixed'&&calc.target>0&&calc.target<500000){
        ytdWarn+=' · <span style="color:#f59e0b;">⚠ Fixed YTD target looks wrong — reload Excel (expect Total from history sheet, e.g. 14,982,111)</span>';
      }
      var cm=GLK_YTD_META.currentMonth;
      var cmTxt=cm?(' · Live month: '+cm.label+' '+cm.year):'';
      sum.innerHTML='<strong>'+mqCaseDisplayName(calc.isBest?'best':'worst')+'</strong> · '+actLbl2+' '+fmtLines(calc.actualsQtd)+
        ' · Gross Won '+fmtLines(calc.gross100)+
        ' · In-flight Gross '+fmtLines(calc.inflightGross)+
        ' · Churn '+fmtLines(calc.inflightChurn)+
        ' · Net Forecast '+fmtLines(calc.forecast)+
        ' · Target '+fmtLines(calc.target)+' · '+gapTxt+cmTxt+ytdWarn;
    }
  }
}
