    gaPoints:num(it.Gross_x0020_Adds),mrc:num(it.Monthly_x0020_Recurring_x0020_Ch),
    otc:num(it.One_x0020_Time_x0020_Charges_x00),duration:it.Contract_x0020_Duration||'—',
    tcv:num(it.Total_x0020_Contact_x0020_Value_),status:status,
    closureProb:closureProb,forecastCategory:forecastCategory||'—',
    expectedActivation:it.Expected_x0020_Contract_x0020_Si||null,
    contractSigned:it.Actual_x0020_Contract_x0020_Sign||null,
    proposedDate:it.Proposed_x0020_Date||null,lostDate:it.No_x0020_Bid_x002f_Lost_x002f_Ca||null,
    billedDate:it.BilledDate||null,lostReason:it.Lost_x0020_Reason||'—',
    customerCode:it.CustomerCode||'—',complexity:it.Complexity||'—',
    bidManager:it.BidManager||'—',projectManager:it.ProjectManager0||'—',
    pcv:num(it.field5),prepaidPostpaid:it.field8||'—',
    bidRequest:it.BidRequest||'—',comments:it.Comments_x002f_Remarks||'—',
    pocName:it.POCName||'—',pocEmail:it.POCEmailID||'—',contactNo:it.ContactNo||'—',
    mnp:it.MNP||'—',thirdParty:it.Third_x0020_Party||'—',vendorName:it.Vendor_x0020_Name||'—',
    gaLines:num(it.GA_x0020_Lines),rfpSubmissionDate:it.RFP_x0020_Submission_x0020_Date||null,
    solutionAssignedDate:it.SolutionAssignedDate||null,
    buildingName:it.Building_x0020_Name||'—',buildingUnit:it.Building_x0020_Unit||'—',
    buildingFloor:it.Building_x0020_Floor||'—',buildingStatus:it.field3||'—',
    churnReason:it.field6||'—',pocJobRole:it.field4||'—',
    bidManagerRequired:it.BidManagerRequired||'—',solutionManagerRequired:it.SolutionManagerRequired||'—',
    serviceRequirement:it.ServiceRequirement||'—',rfps:it.RFPs||'—',
    m2mUseCase:it.M2M_x0020_Use_x0020_Case||'—',m2mCustomerType:it.M2M_x0020_Customer_x0020_Type||'—',
    m2mIndustryVertical:it.M2M_x0020_Industry_x0020_Vertica||'—',
    myId:it.My_x0020_ID||'—',userName:it.UserName||'—',bmAssignedDate:it.BMassingedDate||null,
    amName:it.group?(it.group.Title||'—'):'—',amEmail:it.group?(it.group.EMail||''):'',
    created:it.Created||null,modified:it.Modified||null,
