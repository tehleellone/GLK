  var targetM=targetVal/1e6;
  var minStepM=Math.max(0.55,targetM*0.06);
  var STEP_COLORS=['#1d4ed8','#2563eb','#3b82f6','#60a5fa','#93c5fd','#4f46e5','#6366f1','#818cf8','#a5b4fc','#c7d2fe'];
  function dispHM(v){return Math.max(v/1e6,minStepM);}
  function pushBar(b,meta){
    var idx=bars.length;
    bars.push(b);
    barMeta.push({label:meta||b.meta||''});
    labelList.push(b.custName||'');
    return idx;
  }
  var wbM=wonBilledVal/1e6;
  dispTopM=wbM>0?wbM:0;
  var wbIdx=pushBar({
    value:wonBilledVal,trueCum:wonBilledVal,
    displayStart:0,displayEnd:dispTopM,
    color:'#16a34a',type:'base',meta:'Won + Billed · '+fmt(wonBilledVal),custName:'Won+Billed'
  },'Won + Billed · '+fmt(wonBilledVal));
  sectionGroups.push({key:'wb',label:'Won + Billed',color:'#16a34a',startIdx:wbIdx,endIdx:wbIdx});
  trueCum=wonBilledVal;
  var infStart=-1;
  top.items.forEach(function(p,i){
    if(p.value<=0) return;
    trueCum+=p.value;
    var dStart=dispTopM,dEnd=dispTopM+dispHM(p.value);
    dispTopM=dEnd;
    var idx=pushBar({
      value:p.value,trueCum:trueCum,
      displayStart:dStart,displayEnd:dEnd,
      color:STEP_COLORS[i%STEP_COLORS.length],type:'step',
      meta:'Proposed (In Forecast) · '+p.name+' · '+fmt(p.value),
      custName:glkBridgeBarLabel(p.name,p.value)
    },'Proposed · '+p.name+' · '+fmt(p.value));
    if(infStart<0){infStart=idx;sectionGroups.push({key:'inf',label:'In Forecast',color:'#2563eb',startIdx:idx,endIdx:idx});}
    else sectionGroups[sectionGroups.length-1].endIdx=idx;
  });
  if(inForecastOthers>0){
    trueCum+=inForecastOthers;
    var dStart=dispTopM,dEnd=dispTopM+dispHM(inForecastOthers);
    dispTopM=dEnd;
    var oIdx=pushBar({
      value:inForecastOthers,trueCum:trueCum,
      displayStart:dStart,displayEnd:dEnd,color:'#3b82f6',type:'step',
      meta:'Proposed (In Forecast) · Others · '+fmt(inForecastOthers),custName:'Others'
    },'In Forecast · Others · '+fmt(inForecastOthers));
    if(sectionGroups.length&&sectionGroups[sectionGroups.length-1].key==='inf') sectionGroups[sectionGroups.length-1].endIdx=oIdx;
    else sectionGroups.push({key:'inf',label:'In Forecast',color:'#2563eb',startIdx:oIdx,endIdx:oIdx});
  }
  if(isBest&&outForecastVal>0){
    trueCum+=outForecastVal;
    var odStart=dispTopM,odEnd=dispTopM+dispHM(outForecastVal);
    dispTopM=odEnd;
    var outIdx=pushBar({
      value:outForecastVal,trueCum:trueCum,
      displayStart:odStart,displayEnd:odEnd,color:'#ea580c',type:'outforecast',
      meta:'Opportunity (Out Forecast) · '+fmt(outForecastVal),custName:'Out Forecast'
    },'Opportunity · Out Forecast · '+fmt(outForecastVal));
    sectionGroups.push({key:'outf',label:'Out Forecast',color:'#ea580c',startIdx:outIdx,endIdx:outIdx});
  }
  var gapVal=over?0:gap;
  var overVal=over?Math.abs(gap):0;
  if(gapVal>0){
    var gStart=dispTopM;
    var gEnd=Math.max(dispTopM+dispHM(gapVal),targetM);
    dispTopM=gEnd;
    var gIdx=pushBar({
      value:gapVal,trueCum:targetVal,
      displayStart:gStart,displayEnd:gEnd,color:'#f59e0b',type:'gap',
      meta:'Gap · '+fmt(gapVal)+' short of target',custName:'Gap'
    },'Gap · '+fmt(gapVal)+' short');
    sectionGroups.push({key:'gap',label:'Gap to Target',color:'#f59e0b',startIdx:gIdx,endIdx:gIdx});
  }else if(overVal>0){
    var ovStart=dispTopM,ovEnd=dispTopM+dispHM(overVal);
    dispTopM=ovEnd;
    var ovIdx=pushBar({
      value:overVal,trueCum:total,
      displayStart:ovStart,displayEnd:ovEnd,color:'#0ea5e9',type:'over',
      meta:'Over Target · +'+fmt(overVal),custName:'Over Target'
    },'Over Target · +'+fmt(overVal));
    sectionGroups.push({key:'over',label:'Over Target',color:'#0ea5e9',startIdx:ovIdx,endIdx:ovIdx});
  }
  var targetOffScale=targetM>dispTopM*1.8;
  var targetDisp=targetOffScale?null:targetM;
  var yMax=Math.max(dispTopM,targetDisp||0,targetM,0.001)*1.08;
  var floatData=bars.map(glkBridgeFloatBar);
  var bg=bars.map(function(b){return b.color;});
  var bridgePlugins=[
    glkBridgeMinPxPlugin(bars,42),
    glkBridgeBarLabelPlugin(bars),
    glkBridgeGroupPlugin(sectionGroups,c),
    glkBridgeConnectorPlugin(bars)
  ];
  if(targetDisp!=null){
    bridgePlugins.push(glkBridgeTargetLinePlugin(targetDisp,'Target '+fmt(targetVal),c));
    bridgePlugins.push(glkBridgeOverZonePlugin(wonBilledVal,targetVal));
  }
  var canvas=el('chartBridge');
  if(!canvas) return;
  try{
  CHARTS.bridge=new Chart(canvas,{
    type:'bar',
    plugins:bridgePlugins,
    data:{labels:labelList,glkBars:bars,datasets:[{
      label:(metric==='mrc'?'MRC':'TCV'),
      data:floatData,
      backgroundColor:bg,
      borderRadius:5,
      borderSkipped:false,
      barPercentage:.88,
      categoryPercentage:.82,
      maxBarThickness:64
    }]},
    options:{responsive:true,maintainAspectRatio:false,
      layout:{padding:{bottom:78,top:targetOffScale?20:12,left:6,right:10}},
      plugins:{
        legend:{display:false},
        tooltip:{backgroundColor:'rgba(15,10,30,.88)',padding:14,cornerRadius:12,titleFont:{size:12,weight:'700'},bodyFont:{size:12},
          callbacks:{
            title:function(items){return barMeta[items[0].dataIndex]?barMeta[items[0].dataIndex].label:'';},
            label:function(ctx){
              var b=bars[ctx.dataIndex];
              if(b.type==='base') return '  Won + Billed '+fmt(b.value);
              if(b.type==='gap') return '  Gap '+fmt(b.value)+' short of target';
              if(b.type==='over') return '  Over Target +'+fmt(b.value);
              if(b.type==='outforecast') return '  Out Forecast '+fmt(b.value);
              return '  +'+fmt(b.value);
            },
            afterBody:function(items){
              var b=bars[items[0].dataIndex];
              if(b.type==='step'||b.type==='outforecast') return ['  Running total: '+fmt(b.trueCum)];
              return [];
            }
          }
        }
      },
      scales:{
        x:{ticks:{display:false},grid:{display:false}},
        y:{min:0,max:yMax,grace:0,ticks:{color:c.text,font:{size:10},callback:function(v){return v+'M';}},grid:{color:c.grid},
          title:{display:true,text:'AED (M) · '+mqCaseDisplayName(isBest?'best':'worst'),color:c.text,font:{size:9,weight:'600'}}}
      }
    }
  });
  }catch(err){console.error('[GLK] Bridge chart error:',err);}
  var wrap=el('bridgeControlsWrap');
  if(wrap){
    var gapTxt=over?('<span style="color:#0ea5e9;">+'+fmt(overVal)+' over target</span>'):('<span style="color:#f59e0b;">'+fmt(gapVal)+' short of target</span>');
    wrap.innerHTML='<div style="display:flex;flex-direction:column;gap:.45rem;margin-top:.65rem;">'+
      glkBridgeControlsHtml(bids)+
      '<div style="font-size:.68rem;color:var(--t3);font-weight:600;line-height:1.5;">'+
      '<strong>'+mqCaseDisplayName(isBest?'best':'worst')+'</strong> · Won+Billed '+fmt(wonBilledVal)+
      ' · In Forecast '+fmt(top10Sum+inForecastOthers)+
      (isBest?' · Out Forecast '+fmt(outForecastVal):'')+
      ' · Total '+fmt(total)+' · Target '+fmt(targetVal)+' · '+gapTxt+
      (bridgeDrill!=='all'&&bridgeDrillVal?' · Drill: '+bridgeDrillVal:'')+
      (targetOffScale?' · <span style="color:#ef4444;">Target above chart</span>':'')+
      '</div></div>';
  }
  // Compare year summary
  if(glkCompareEnabled&&wrap){
    var prevScoped=glkFilterByChartPeriodYear(bids,chartPeriod,glkCompareYear);
    if(bridgeDrill==='vertical'&&bridgeDrillVal) prevScoped=prevScoped.filter(function(b){return b.vertical===bridgeDrillVal;});
    else if(bridgeDrill==='am'&&bridgeDrillVal) prevScoped=prevScoped.filter(function(b){return b.amName===bridgeDrillVal||b.amEmail===bridgeDrillVal;});
    var pw=prevScoped.filter(function(b){return b.status==='Won'||b.status==='Billed';}).reduce(function(s,b){return s+glkBidMetric(b,metric);},0);
    var pi=glkBridgeTop10Asc(prevScoped.filter(function(b){return b.status==='Proposed';}),metric);
    var po=isBest?prevScoped.filter(function(b){return b.status==='Opportunity';}).reduce(function(s,b){return s+glkBidMetric(b,metric);},0):0;
    var pt=pw+pi.items.reduce(function(s,p){return s+p.value;},0)+pi.others+po;
    var pg=targetVal-pt;
    var cmpLine=el('bridgeCompareLine');
    if(!cmpLine){
      cmpLine=document.createElement('div');
      cmpLine.id='bridgeCompareLine';
      cmpLine.style.cssText='font-size:.66rem;color:var(--t3);font-weight:600;margin-top:.2rem;';
      wrap.appendChild(cmpLine);
    }
    cmpLine.textContent='Compare '+glkCompareYear+': Total '+fmt(pt)+(pg>0?' · '+fmt(pg)+' short':' · +'+fmt(Math.abs(pg))+' over');
  }else{
    var rm=el('bridgeCompareLine'); if(rm) rm.remove();
  }
}
let lbMode='hd';
let lbMetric='tcv';
let vertMetric='tcv';
function renderLeaderboard(bids,c){
  destroyChart('lb');
  const role=USER.role;

  // Determine available modes based on role
  let modes=[];
if(role==='Admin'||role==='CEO'||role==='Admin (Dev)'||role==='admin'||role==='ADMIN'){    modes=[
      {k:'hd',l:'Head Directors'},
      {k:'ad',l:'Account Directors'},
      {k:'am',l:'Account Managers'}
    ];
  } else if(role==='Head Director'){
    modes=[
      {k:'ad',l:'Account Directors'},
      {k:'am',l:'Account Managers'}
    ];
    if(lbMode==='hd') lbMode='ad';
  } else if(role==='Account Director'){
    modes=[{k:'am',l:'Account Managers'}];
    lbMode='am';
  } else {
    // Account Manager — hide leaderboard entirely
    const card=el('chartLeaderboard')?.closest('.chart-card');
    if(card) card.style.display='none';
    return;
  }

  // Build HD/AD/AM toggle buttons
  const wrap=el('lbControlsWrap');
  if(wrap){
    wrap.innerHTML=`<div style="display:flex;gap:.5rem;margin-bottom:.75rem;flex-wrap:wrap;">
      ${modes.map(m=>`<button type="button"
        onclick="lbMode='${m.k}';renderLeaderboard(getViewBids(),getChartColors())"
        style="padding:.35rem 1rem;border-radius:8px;font-size:.78rem;font-weight:700;
        border:2px solid ${lbMode===m.k?'transparent':'var(--border)'};cursor:pointer;
        background:${lbMode===m.k?'var(--grad)':'var(--bg-secondary)'};
        color:${lbMode===m.k?'#fff':'var(--t3)'};transition:all .18s;">
        ${m.l}</button>`).join('')}
    </div>`;
  }

  // Build metric toggle buttons
  const metricWrap=el('lbMetricToggle');
  if(metricWrap){
    const isMobile=selPF==='Mobile';
    const metrics=isMobile?
      [{k:'tcv',l:'TCV'},{k:'mrc',l:'GA Pts'},{k:'otc',l:'OTC'},{k:'pcv',l:'Catelog MRC'}]:
      [{k:'tcv',l:'TCV'},{k:'mrc',l:'MRC'},{k:'otc',l:'OTC'},{k:'pcv',l:'Catelog MRC'}];
    metricWrap.innerHTML=metrics.map(m=>`<button type="button"
      onclick="lbMetric='${m.k}';renderLeaderboard(getViewBids(),getChartColors())"
      style="padding:.25rem .75rem;border-radius:6px;font-size:.72rem;font-weight:700;
      border:1px solid ${lbMetric===m.k?'transparent':'var(--border)'};cursor:pointer;
      background:${lbMetric===m.k?'var(--grad)':'var(--bg-secondary)'};
      color:${lbMetric===m.k?'#fff':'var(--t3)'};transition:all .15s;">
      ${m.l}</button>`).join('');
  }

  // Build data entries scoped correctly per role + mode
  const map={};

  if(lbMode==='hd'){
    // Admin only — all HDs
    bids.forEach(b=>{
      const k=b.headDirector||'?';
      if(!k||k==='—') return;
      if(!map[k]) map[k]={won:0,total:0,wonTCV:0,mrc:0,otc:0,pcv:0,ga:0};
      if(STATUS_WON.includes(b.status)){map[k].won++;map[k].wonTCV+=b.tcv;}
      map[k].mrc+=b.mrc;map[k].otc+=b.otc;map[k].pcv+=b.pcv;map[k].ga+=b.gaPoints;map[k].total++;
    });

  } else if(lbMode==='ad'){
    // Admin → all ADs | HD → only ADs under this HD
    let scope=bids;
    if(role==='Head Director'){
      const myHD=findMyHD();
      scope=bids.filter(b=>b.headDirector===myHD);
    }
    scope.forEach(b=>{
      const k=b.accountDirector||'?';
      if(!k||k==='—') return;
      if(!map[k]) map[k]={won:0,total:0,wonTCV:0,mrc:0,otc:0,pcv:0,ga:0};
      if(STATUS_WON.includes(b.status)){map[k].won++;map[k].wonTCV+=b.tcv;}
      map[k].mrc+=b.mrc;map[k].otc+=b.otc;map[k].pcv+=b.pcv;map[k].ga+=b.gaPoints;map[k].total++;
    });

  } else {
    // Admin → all AMs | HD → AMs under his ADs | AD → only his AMs
    let scope=bids;
    if(role==='Head Director'){
      const myHD=findMyHD();
      scope=bids.filter(b=>b.headDirector===myHD);
    } else if(role==='Account Director'){
      const myAD=findMyAD();
      scope=bids.filter(b=>b.accountDirector===myAD);
    }
    scope.forEach(b=>{
      const k=b.amName||'?';
      if(!k||k==='—') return;
      if(!map[k]) map[k]={won:0,total:0,wonTCV:0,mrc:0,otc:0,pcv:0,ga:0};
      if(STATUS_WON.includes(b.status)){map[k].won++;map[k].wonTCV+=b.tcv;}
      map[k].mrc+=b.mrc;map[k].otc+=b.otc;map[k].pcv+=b.pcv;map[k].ga+=b.gaPoints;map[k].total++;
    });
  }

  const getMetricVal=(v)=>{
    if(lbMetric==='tcv') return +(v.wonTCV/1e6).toFixed(2);
    if(lbMetric==='mrc') return +(v.mrc/1e6).toFixed(2);
    if(lbMetric==='otc') return +(v.otc/1e6).toFixed(2);
    if(lbMetric==='pcv') return +(v.pcv/1e6).toFixed(2);
    return 0;
  };
  const metricLabel={'tcv':'TCV','mrc':selPF==='Mobile'?'GA Pts':'MRC','otc':'OTC','pcv':'Catelog MRC'}[lbMetric];

  const entries=Object.entries(map);
  const sorted=entries.sort((a,b)=>getMetricVal(b[1])-getMetricVal(a[1])).slice(0,12);

  if(!sorted.length){
    el('chartLeaderboard').parentElement.innerHTML+='<div style="padding:20px;color:var(--t3);text-align:center;font-size:.85rem;">No data available</div>';
    return;
  }

  // Color bars: green=high win rate, accent=mid, red=low
  const barColors=sorted.map(([,v])=>{
    const wr=v.total?v.won/v.total:0;
    return wr>=.55?'#10b981':wr>=.30?c.p1:'#ef4444';
  });

  // Dynamic height based on number of entries
  const chartHeight=Math.max(320, sorted.length*52);
  const canvasWrap=el('chartLeaderboard').parentElement;
  canvasWrap.style.height=chartHeight+'px';

  CHARTS.lb=new Chart(el('chartLeaderboard'),{
    type:'bar',
    data:{
      labels:sorted.map(([k])=>k),
      datasets:[{
        label:metricLabel+' (M)',
        data:sorted.map(([,v])=>getMetricVal(v)),
        backgroundColor:barColors,
        borderRadius:8,
        borderSkipped:false,
        barThickness:28,
      }]
    },
    options:{
      indexAxis:'y',
      responsive:true,
      maintainAspectRatio:false,
      layout:{padding:{right:60}},
      plugins:{
        legend:{display:false},
        tooltip:{
          backgroundColor:'rgba(0,0,0,.82)',
          padding:14,
          cornerRadius:10,
          titleFont:{size:13,weight:'700'},
          bodyFont:{size:12},
          bodySpacing:5,
          callbacks:{
            label:ctx=>'  '+metricLabel+': '+ctx.parsed.x.toFixed(2)+'M',
            afterLabel:ctx=>{
              const d=sorted[ctx.dataIndex][1];
              const wr=d.total?(d.won/d.total*100).toFixed(1):0;
              return [
                '  Total Bids: '+d.total,
                '  Won: '+d.won,
                '  Win Rate: '+wr+'%',
                '  MRC: '+fmt(d.mrc),
                '  OTC: '+fmt(d.otc),
              ];
            }
          }
        }
      },
      scales:{
        x:{
          ticks:{color:c.text,font:{size:11},callback:v=>v+'M'},
          grid:{color:c.grid},
          border:{dash:[4,4]},
          beginAtZero:true
        },
        y:{
          ticks:{
            color:c.text,
            font:{size:12,weight:'700'},
            padding:12,
          },
          grid:{display:false}
        }
      }
    },
    plugins:[{
      id:'lbValueLabels',
      afterDatasetsDraw(chart){
        const ctx=chart.ctx;
        chart.data.datasets[0].data.forEach((val,i)=>{
          const meta=chart.getDatasetMeta(0);
          const bar=meta.data[i];
          const pos=bar.tooltipPosition();
          ctx.save();
          ctx.font='bold 11px Inter,sans-serif';
          ctx.fillStyle=c.text;
          ctx.textAlign='left';
          ctx.textBaseline='middle';
          ctx.fillText(val.toFixed(2)+'M', pos.x+8, pos.y);
          ctx.restore();
        });
      }
    }]
  });
}
