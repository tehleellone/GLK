.stat-detail-row span:last-child{font-weight:700;color:var(--t1)}
.stat-detail-note{margin-top:.4rem;font-size:.68rem;color:var(--t3);font-style:italic;border-top:1px solid var(--border);padding-top:.3rem}
.period-btn{
  padding:.2rem .55rem;border-radius:6px;font-size:.7rem;font-weight:600;
  background:var(--bg-secondary);border:1px solid var(--border);
  color:var(--t3);cursor:pointer;transition:all .15s;
}
.period-btn:hover{border-color:var(--border-s);color:var(--t1)}
.period-btn.active{background:var(--grad);border-color:transparent;color:#fff}
.pf-tab{
  padding:.45rem 1.2rem;border-radius:8px;font-size:.82rem;font-weight:700;
  background:var(--bg-card);border:2px solid var(--border);
  color:var(--t2);cursor:pointer;transition:all .18s;
}
.pf-tab:hover{border-color:var(--border-s);color:var(--t1)}
.pf-tab.active{background:var(--grad);border-color:transparent;color:#fff;box-shadow:0 2px 10px var(--glow)}
.status-tile-selected::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:#fff;opacity:.5}
.stat-card.tile-active{box-shadow:0 0 0 2px var(--acc),var(--ch)!important;transform:translateY(-2px)}

.stat-card.tile-dimmed{opacity:.38;transform:none!important;box-shadow:var(--cs)!important}
.lm-tile.selected::after{content:'✓ Selected';position:absolute;bottom:7px;right:10px;font-size:.62rem;font-weight:700;color:var(--acc);background:var(--nab);border:1px solid var(--nab2);padding:1px 7px;border-radius:20px;}
.stat-card.tile-active::after{content:'✓';position:absolute;top:6px;right:8px;font-size:.7rem;font-weight:900;color:var(--acc);}

/* Date filters inside main filters panel */
.filters-date-divider{font-size:.68rem;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.06em;margin:.75rem 0 .55rem;padding-top:.65rem;border-top:1px dashed var(--border)}
.filter-bar-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:.55rem .65rem;align-items:end}
.fb-group{display:flex;flex-direction:column;gap:.22rem}
.fb-group-label{font-size:.65rem;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.05em}
.fb-select{padding:.42rem .65rem;border-radius:8px;border:1px solid var(--border);background:var(--bg-input);color:var(--t1);font-size:.8rem;width:100%;cursor:pointer}
.glk-date-hint{font-size:.71rem;color:var(--t3);margin:.35rem 0 .5rem;line-height:1.4}
.glk-date-rule{border:1px dashed var(--border);border-radius:10px;padding:.65rem .75rem;margin-bottom:.55rem;background:var(--bg-secondary)}
.glk-rule-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem}
.glk-rule-title{font-size:.74rem;font-weight:800;color:var(--t1)}
.glk-rule-remove{padding:.2rem .55rem;border-radius:6px;font-size:.68rem;font-weight:700;background:rgba(220,38,38,.08);border:1px solid rgba(220,38,38,.25);color:#dc2626;cursor:pointer;border:none}
.glk-add-rule-btn{padding:.38rem .85rem;border-radius:8px;font-size:.76rem;font-weight:700;background:var(--nab);border:1px solid var(--nab2);color:var(--acc);cursor:pointer;margin-top:.35rem}
.glk-compare-row{display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;margin-top:.75rem;padding-top:.65rem;border-top:1px dashed var(--border)}
.glk-compare-toggle{display:flex;align-items:center;gap:.45rem;font-size:.78rem;font-weight:600;color:var(--t2);cursor:pointer;margin:0}
.glk-compare-toggle input{width:15px;height:15px;accent-color:var(--acc)}
.glk-compare-year-sel{max-width:110px;padding:.38rem .55rem!important}
.glk-compare-banner{display:none;grid-template-columns:1fr auto 1fr;gap:.85rem;align-items:stretch;margin-bottom:1rem;padding:.85rem 1rem;background:var(--bg-card);border:1px solid var(--border-s);border-radius:12px;box-shadow:var(--cs)}
.glk-compare-banner.visible{display:grid}
.glk-compare-col{padding:.65rem .75rem;border-radius:9px;background:var(--bg-secondary);border:1px solid var(--border)}
.glk-compare-col.primary{border-color:var(--nab2);background:var(--nab)}
.glk-compare-col-label{font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--t3);margin-bottom:.35rem}
.glk-compare-metric{display:flex;justify-content:space-between;gap:.5rem;font-size:.74rem;padding:.12rem 0}
.glk-compare-metric span:first-child{color:var(--t3)}
.glk-compare-metric span:last-child{font-weight:800;color:var(--t1)}
.glk-compare-vs{display:flex;align-items:center;justify-content:center;font-size:.82rem;font-weight:900;color:var(--acc)}
.glk-compare-delta{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:.5rem .85rem;padding-top:.55rem;border-top:1px solid var(--border);font-size:.72rem;font-weight:700;color:var(--t2)}
@media(max-width:900px){.glk-compare-banner.visible{grid-template-columns:1fr}.glk-compare-vs{padding:.35rem 0}}
</style>
</head>
<body>

