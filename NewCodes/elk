    spUploadBinary(uploadUrl,arrayBuffer,digest,function(err3,data){
      if(err3) return cb(err3);
      spGetMobileReportMeta(function(err4,meta){
        if(meta){
          meta.originalName=originalName||meta.originalName;
          meta.storage='sharepoint';
          return cb(null,meta);
        }
        var modified=null;
        try{ modified=data.d.TimeLastModified||data.d.Modified||null; }catch(e){}
        cb(null,{
          filename:SP_MOBILE_REPORT_FILE,
          originalName:originalName||SP_MOBILE_REPORT_FILE,
          uploadedAt:modified||new Date().toISOString(),
          serverPath:SP_MOBILE_REPORT_PATH,
          spUrl:SP_MOBILE_REPORT_WEB_URL,
          storage:'sharepoint'
        });
      });
    });
  });
}
