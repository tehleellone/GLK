.mq-bridge-state{display:flex;align-items:center;flex-wrap:wrap;gap:.35rem;margin-bottom:.75rem;padding:.55rem .75rem;background:var(--bg-card);border:1px solid var(--border);border-radius:9px;font-size:.76rem;font-weight:700;color:var(--t2)}
.mq-state-chip{padding:.2rem .55rem;border-radius:6px;background:var(--nab);color:var(--acc);font-weight:800}
