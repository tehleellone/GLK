.mq-control-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:.75rem}
.mq-control-block{display:flex;flex-direction:column;gap:.35rem;padding:.65rem .75rem;background:var(--bg-card);border:1px solid var(--border);border-radius:10px}
