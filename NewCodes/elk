function mqIdbOpen(cb){
  if(typeof indexedDB==='undefined') return cb(new Error('IndexedDB unavailable'));
  var req=indexedDB.open(MQ_IDB_NAME,1);
  req.onerror=function(){ cb(req.error||new Error('IndexedDB open failed')); };
  req.onupgradeneeded=function(e){
    var db=e.target.result;
    if(!db.objectStoreNames.contains(MQ_IDB_STORE)) db.createObjectStore(MQ_IDB_STORE);
  };
  req.onsuccess=function(){ cb(null,req.result); };
}
function mqArrayBufferCopy(buf){
  if(!buf) return null;
  try{ return buf.slice(0); }catch(e){
    var u=new Uint8Array(buf);
    return u.buffer.slice(u.byteOffset,u.byteOffset+u.byteLength);
  }
}
function mqBufToB64(buf){
  var bytes=new Uint8Array(buf);
  var CHUNK=0x8000,parts=[];
  for(var i=0;i<bytes.length;i+=CHUNK) parts.push(String.fromCharCode.apply(null,bytes.subarray(i,i+CHUNK)));
  return btoa(parts.join(''));
}
function mqB64ToBuf(b64){
  var bin=atob(b64),len=bin.length,buf=new ArrayBuffer(len),u=new Uint8Array(buf);
  for(var i=0;i<len;i++) u[i]=bin.charCodeAt(i);
  return buf;
}
function mqCacheSaveReport(arrayBuffer,meta,cb){
  cb=cb||function(){};
  var metaOut=Object.assign({},meta||{},{storage:meta&&meta.storage?meta.storage:'local',cachedAt:new Date().toISOString()});
  var bufCopy=mqArrayBufferCopy(arrayBuffer);
  try{ localStorage.setItem(MQ_LS_META_KEY,JSON.stringify(metaOut)); }catch(e){}
  try{
    if(bufCopy&&bufCopy.byteLength<=MQ_LS_MAX_B64) localStorage.setItem(MQ_LS_DATA_KEY,mqBufToB64(bufCopy));
    else localStorage.removeItem(MQ_LS_DATA_KEY);
  }catch(e2){ try{ localStorage.removeItem(MQ_LS_DATA_KEY); }catch(e3){} }
  mqIdbOpen(function(err,db){
    if(err){
      console.warn('[GLK] IDB cache save skipped:',err.message);
      return cb(null,metaOut);
    }
    var tx=db.transaction(MQ_IDB_STORE,'readwrite');
    tx.objectStore(MQ_IDB_STORE).put({buffer:bufCopy,meta:metaOut},'latest');
    tx.oncomplete=function(){ cb(null,metaOut); };
    tx.onerror=function(){ cb(null,metaOut); };
  });
}
function mqCacheLoadReport(cb){
  var meta=null;
  try{ meta=JSON.parse(localStorage.getItem(MQ_LS_META_KEY)||'null'); }catch(e){}
  function tryLsB64(){
    try{
      var b64=localStorage.getItem(MQ_LS_DATA_KEY);
      if(b64&&b64.length>20) return cb(null,mqB64ToBuf(b64),meta);
    }catch(e){}
    return cb(new Error('No cached report'),null,null);
  }
  mqIdbOpen(function(err,db){
    if(err) return tryLsB64();
    var tx=db.transaction(MQ_IDB_STORE,'readonly');
    var req=tx.objectStore(MQ_IDB_STORE).get('latest');
    req.onsuccess=function(){
      if(!req.result||!req.result.buffer) return tryLsB64();
      cb(null,mqArrayBufferCopy(req.result.buffer),req.result.meta||meta);
    };
    req.onerror=function(){ tryLsB64(); };
  });
}
function glkSpLoadMobileReport(cb){
  cb=cb||function(){};
  function loadFromCache(spErr){
    mqCacheLoadReport(function(errC,bufferC,metaC){
      if(!errC&&bufferC&&bufferC.byteLength>0){
        glkParseAndSetMobileReport(bufferC,function(e,parsed){
          if(!e&&parsed){
            GLK_MOBILE_REPORT_META=Object.assign({},metaC||{},{storage:(metaC&&metaC.storage)||'local-cache',spError:spErr?spErr.message:null});
            return cb(null,parsed,GLK_MOBILE_REPORT_META);
          }
          cb(spErr||errC||new Error('No mobile report found. Check SharePoint SiteAssets file or use Replace File.'),null,null);
        });
        return;
      }
      cb(spErr||errC||new Error('No mobile report found at SharePoint SiteAssets. Upload the workbook once with Replace File.'),null,null);
    });
  }
  spDownloadMobileReport(function(err,buffer){
    if(!err&&buffer&&buffer.byteLength>0){
      spGetMobileReportMeta(function(e2,meta){
        var m=Object.assign({},meta||{},{storage:'sharepoint',filename:SP_MOBILE_REPORT_FILE,spUrl:SP_MOBILE_REPORT_WEB_URL});
        mqCacheSaveReport(buffer,m,function(){
          glkParseAndSetMobileReport(buffer,function(e3,parsed){
            if(e3) return loadFromCache(e3);
            GLK_MOBILE_REPORT_META=m;
            cb(null,parsed,m);
          });
        });
      });
      return;
    }
    console.warn('[GLK] SharePoint report load failed:',err?err.message:err);
    loadFromCache(err);
  });
}
