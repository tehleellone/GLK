function mqFractionalMonthsBetween(startDate,endDate){
  if(!startDate||!endDate) return 0;
  var s=mqDateOnly(startDate), e=mqDateOnly(endDate);
  if(e<s) return 0;
  if(s.getTime()===e.getTime()) return 1/mqDaysInMonth(s.getFullYear(),s.getMonth());
  var total=0, y=s.getFullYear(), m=s.getMonth(), ey=e.getFullYear(), em=e.getMonth();
  while(y<ey||(y===ey&&m<=em)){
    var dim=mqDaysInMonth(y,m);
    var ms=new Date(y,m,1), me=new Date(y,m,dim);
    var rs=s>ms?s:ms, re=e<me?e:me;
    if(re>=rs){
      var days=Math.round((re-rs)/86400000)+1;
      total+=days/dim;
    }
    m++; if(m>11){m=0;y++;}
  }
  return total;
}
/** Inclusive calendar days from start through end. */
function mqInclusiveDaysBetween(startDate,endDate){
  var s=mqDateOnly(startDate), e=mqDateOnly(endDate);
  if(e<s) return 0;
  return Math.round((e-s)/86400000)+1;
}
/** Aggregated Revenue MRC: (days activation→period-end ÷ days in activation month) × MRC */
function mqAggregatedRevenueMrc(actDate,endDate,mrcVal){
  if(!actDate||!endDate) return 0;
  if(mqDateOnly(actDate)>mqDateOnly(endDate)) return 0;
  var mrc=num(mrcVal);
  if(mrc<=0) return 0;
  var days=mqInclusiveDaysBetween(actDate,endDate);
  if(days<=0) days=1;
  var dim=mqDaysInMonth(actDate.getFullYear(),actDate.getMonth());
  return (days/dim)*mrc;
}
function mqQuarterEndDate(year,quarter){
