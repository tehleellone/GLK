function loadData(){
  const select=[
    'Id','Title','Type_x0020_of_x0020_Request','Type_x0020_of_x0020_Contract',
    'Segment','Account_x0020_Director','Solution_x0020_Manager','Head_x0020_Director',
    'Product_x0020_Family','Product_x0020_Category','Services','Gross_x0020_Adds',
    'Monthly_x0020_Recurring_x0020_Ch','One_x0020_Time_x0020_Charges_x00',
    'Contract_x0020_Duration','Total_x0020_Contact_x0020_Value_','Opportunity_x0020_Status',
    'Closure_x0020_Probability','Expected_x0020_Contract_x0020_Si','Actual_x0020_Contract_x0020_Sign',
    'Proposed_x0020_Date','No_x0020_Bid_x002f_Lost_x002f_Ca','BilledDate','Lost_x0020_Reason',
    'CustomerCode','Complexity','BidManager','ProjectManager0','field5','field8',
    'BidRequest','Comments_x002f_Remarks','POCName','POCEmailID','ContactNo',
    'MNP','Third_x0020_Party','Vendor_x0020_Name','GA_x0020_Lines',
    'RFP_x0020_Submission_x0020_Date','SolutionAssignedDate',
    'Building_x0020_Name','Building_x0020_Unit','Building_x0020_Floor','field3','field6','field4',
    'BidManagerRequired','SolutionManagerRequired','ServiceRequirement','RFPs',
    'M2M_x0020_Use_x0020_Case','M2M_x0020_Customer_x0020_Type','M2M_x0020_Industry_x0020_Vertica',
    'My_x0020_ID','UserName','BMassingedDate','Forecast_Category0',
    'Created','Modified',
    'group/Title','group/EMail'
  ].join(',');

  let allResults=[];

  function fetchPage(url){
    spGet(url,function(err,data){
      if(err){
        console.error('Data load error:',err);
        ALL_BIDS=[];
        remapBlankHD();
        buildFilters();
        applyAll();
        glkHideLoader();
        return;
      }
      allResults=allResults.concat(data.d.results);
      console.log('[GLK] Fetched so far:',allResults.length);
      var lt=el('glkLoaderText'); if(lt) lt.textContent='Loading your pipeline… '+allResults.length+' records';
      if(data.d.__next){
        fetchPage(data.d.__next);
      } else {
        console.log('[GLK] All records loaded:',allResults.length);
        ALL_BIDS=allResults.map(mapItem);
        remapBlankHD();
        buildFilters();
        applyAll();
        glkHideLoader();
      }
    });
  }

  const firstUrl=SP_SITE+
    "/_api/web/lists/getbytitle('"+SP_LIST+"')/items"+
    "?$select="+encodeURIComponent(select)+
    "&$expand=group"+
    "&$filter=Created ge '2024-01-01T00:00:00Z' or "+
    "Expected_x0020_Contract_x0020_Si ge '2024-01-01T00:00:00Z' or "+
    "Actual_x0020_Contract_x0020_Sign ge '2024-01-01T00:00:00Z' or "+
    "Proposed_x0020_Date ge '2024-01-01T00:00:00Z' or "+
    "No_x0020_Bid_x002f_Lost_x002f_Ca ge '2024-01-01T00:00:00Z' or "+
    "BilledDate ge '2024-01-01T00:00:00Z' or "+
    "Modified ge '2024-01-01T00:00:00Z'"+
    "&$top=5000&$orderby=Id asc";

  fetchPage(firstUrl);
}function mapItem(it){
  const rawFC=(it.Forecast_Category0||'').trim();
  const rawProb=it.Closure_x0020_Probability||'—';
  const rawStatus=(it.Opportunity_x0020_Status||'—').trim();
