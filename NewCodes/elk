    var wb=XLSX.read(arrayBuffer,{type:'array',cellDates:true,cellNF:true,cellStyles:true});
    var parsed=glkParseQtdWorkbook(wb);
    if(!parsed||(!parsed.mobile&&!parsed.fixed))
      return cb(new Error('Could not find Mobile Net Adds or Fixed Net MRC sections. Use the daily GLK Excel template (.xlsx/.xlsm).'));
    GLK_QTD_REPORT={mobile:parsed.mobile||null,fixed:parsed.fixed||null};
    GLK_YTD_META=parsed.ytdMeta||GLK_YTD_META;
    mqRefreshAllYtdTargetsAfterParse(parsed);
    mqRefreshYtdTargetsOnReport(GLK_QTD_REPORT.mobile);
    mqRefreshYtdTargetsOnReport(GLK_QTD_REPORT.fixed);
    mqSyncActiveReport();
    if(!GLK_QTD_REPORT.mobile) console.warn('[GLK] Mobile Net Adds – Lines section not found in report.');
    if(!GLK_QTD_REPORT.fixed) console.warn('[GLK] Fixed Net MRC section not found in report.');
    if(!mqGetActiveReport()){
      var alt=mqProductFamily==='fixed'?'mobile':'fixed';
      if(GLK_QTD_REPORT[alt]) mqProductFamily=alt;
      mqSyncActiveReport();
      el('mqPfMobile')?.classList.toggle('active',mqProductFamily==='mobile');
      el('mqPfFixed')?.classList.toggle('active',mqProductFamily==='fixed');
      mqUpdateProductFamilyUi();
    }
    cb(null,parsed);
  }catch(err){ cb(err); }
}
window.glkMobileReportUpload=function(file){
  if(!file) return;
  if(typeof XLSX==='undefined'){ alert('Excel parser not loaded. Refresh the page.'); return; }
  var reader=new FileReader();
  reader.onload=function(e){
    var buf=e.target.result;
    glkParseAndSetMobileReport(buf,function(err){
      if(err){ alert(err.message); return; }
      glkShowLoader('Replacing SharePoint workbook…');
      spUploadMobileReport(buf,file.name,function(err2,meta){
        if(err2){
          console.error('[GLK] SP upload error:',err2);
          mqCacheSaveReport(buf,{filename:SP_MOBILE_REPORT_FILE,originalName:file.name,uploadedAt:new Date().toISOString(),storage:'local-cache',spError:err2.message},function(){
            GLK_MOBILE_REPORT_META={filename:SP_MOBILE_REPORT_FILE,originalName:file.name,uploadedAt:new Date().toISOString(),storage:'local-cache',spError:err2.message};
            glkHideLoader();
            glkMobileQtdRefreshUI();
            renderMobileQtdBridge();
            alert('Report loaded on this browser, but SharePoint replace failed:\n'+err2.message+'\n\nCheck Contribute access to SiteAssets on the GKA site.');
          });
          return;
        }
        meta=Object.assign({},meta||{},{storage:'sharepoint',originalName:file.name,filename:SP_MOBILE_REPORT_FILE,spUrl:SP_MOBILE_REPORT_WEB_URL});
        mqCacheSaveReport(buf,meta,function(){
          GLK_MOBILE_REPORT_META=meta;
          glkHideLoader();
          glkMobileQtdRefreshUI();
          renderMobileQtdBridge();
        });
      });
    });
  };
  reader.onerror=function(){ alert('Could not read file.'); };
  reader.readAsArrayBuffer(file);
  var inp=el('mobileReportInp'); if(inp) inp.value='';
};
