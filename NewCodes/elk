function glkPieExternalLabelsPlugin(groups,total,c){
  return {id:'glkPieExtLabels',afterDraw:function(chart){
    var ctx=chart.ctx,meta=chart.getDatasetMeta(0),ca=chart.chartArea;
    if(!meta||!meta.data||!ca) return;
    var cx=(ca.left+ca.right)/2,cy=(ca.top+ca.bottom)/2;
    var outerR=meta.data[0]?meta.data[0].outerRadius:0;
    var items=[];
    meta.data.forEach(function(arc,i){
      var g=groups[i];
      if(!g||g.value<=0) return;
      var pct=total>0?(g.value/total*100):0;
      var mid=(arc.startAngle+arc.endAngle)/2;
      items.push({g:g,pct:pct,mid:mid,right:Math.cos(mid)>=0});
    });
    var left=items.filter(function(it){return !it.right;}).sort(function(a,b){return a.mid-b.mid;});
    var right=items.filter(function(it){return it.right;}).sort(function(a,b){return a.mid-b.mid;});
    var rowH=26,minGap=4;
    function stackSide(list,side){
      if(!list.length) return;
      var n=list.length;
      var totalH=n*rowH+(n-1)*minGap;
      var startY=cy-totalH/2+rowH/2;
      list.forEach(function(it,idx){
        var ly=startY+idx*(rowH+minGap);
        var lx=side==='right'?(ca.right+8):(ca.left-8);
        var elbowX=side==='right'?(cx+outerR+6):(cx-outerR-6);
        var edgeX=cx+Math.cos(it.mid)*outerR,edgeY=cy+Math.sin(it.mid)*outerR;
        ctx.save();
        ctx.strokeStyle=it.g.color;
        ctx.lineWidth=1.2;
        ctx.beginPath();
        ctx.moveTo(edgeX,edgeY);
        ctx.lineTo(elbowX,ly);
        ctx.lineTo(lx,ly);
        ctx.stroke();
        ctx.fillStyle=it.g.color;
        ctx.font='bold 10px Inter,sans-serif';
        ctx.textAlign=side==='right'?'left':'right';
        ctx.textBaseline='bottom';
        ctx.fillText(it.g.label,lx+(side==='right'?4:-4),ly-1);
        ctx.fillStyle=c.text;
        ctx.font='600 9px Inter,sans-serif';
        ctx.textBaseline='top';
        ctx.fillText(it.g.count+' · '+it.pct.toFixed(1)+'% · '+fmt(it.g.value),lx+(side==='right'?4:-4),ly+1);
        ctx.restore();
      });
    }
    stackSide(left,'left');
    stackSide(right,'right');
  }};
}
function glkFilterByChartPeriodYear(bids,period,year){
  year=parseInt(year,10);
  var now=new Date();
  var ref=new Date(year,now.getMonth(),now.getDate());
  return (bids||[]).filter(function(b){
    var iso=getRelevantDate(b);
    if(!iso) return false;
    var d=new Date(iso);
    if(isNaN(d)) return false;
    if(period==='YTD') return d.getFullYear()===year&&d<=ref;
    if(period==='Y') return d.getFullYear()===year;
    if(period==='Q') return d.getFullYear()===year&&Math.ceil((d.getMonth()+1)/3)===Math.ceil((ref.getMonth()+1)/3);
    if(period==='M') return d.getFullYear()===year&&d.getMonth()===ref.getMonth();
    if(period==='W') return d.getFullYear()===year&&getWeekOfYear(d)===getWeekOfYear(ref);
    return true;
  });
}
