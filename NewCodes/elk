function glkBridgeTargetLinePlugin(targetDispY,labelText,c){
  return {id:'glkBridgeTargetLine',afterDatasetsDraw:function(chart){
    var y=chart.scales.y,area=chart.chartArea,ctx=chart.ctx;
    if(!y) return;
    var py=y.getPixelForValue(targetDispY);
    if(py<area.top-2||py>area.bottom+2) return;
    ctx.save();
    ctx.strokeStyle='#ef4444';
    ctx.lineWidth=1.5;
    ctx.setLineDash([6,4]);
    ctx.beginPath();ctx.moveTo(area.left,py);ctx.lineTo(area.right,py);ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle='#ef4444';
    ctx.font='bold 10px Inter';
    ctx.textAlign='right';
    ctx.textBaseline='bottom';
    ctx.fillText(labelText,area.right-6,py-3);
    ctx.restore();
  }};
}
function glkBridgeOverZonePlugin(wonBilledVal,targetVal){
  return {id:'glkBridgeOverZone',afterDatasetsDraw:function(chart){
    if(wonBilledVal<=targetVal) return;
    var y=chart.scales.y,meta=chart.getDatasetMeta(0),bar=meta&&meta.data?meta.data[0]:null;
    if(!bar||!y) return;
    var targetPy=y.getPixelForValue(targetVal/1e6);
    var topPy=Math.min(bar.y,bar.base);
    var x1=bar.x-bar.width/2,x2=bar.x+bar.width/2;
    if(targetPy<=topPy) return;
    var ctx=chart.ctx;
    ctx.save();
    ctx.fillStyle='rgba(14,165,233,.22)';
    ctx.fillRect(x1,topPy,x2-x1,targetPy-topPy);
    ctx.fillStyle='#0ea5e9';
    ctx.font='bold 9px Inter';
    ctx.textAlign='center';
    ctx.textBaseline='bottom';
    ctx.fillText('+'+fmt(wonBilledVal-targetVal)+' secured over target',bar.x,topPy-4);
    ctx.restore();
  }};
}
