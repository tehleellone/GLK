function initAccess(){
  var accessDone=false;
  function finishAccess(fn){ if(!accessDone){ accessDone=true; fn(); } }
  var accessTimer=setTimeout(function(){
    finishAccess(function(){
      var btn=el('launchBtn');
      if(btn&&btn.disabled) showDenied('Connection timed out. Open this page from the GKA SharePoint site (not a local file) and ensure you are signed in.');
    });
  },18000);
  spGet(SP_SITE+'/_api/web/currentuser?$select=Title,Email',function(err,data){
    if(err){
      clearTimeout(accessTimer);
      finishAccess(function(){ showDenied('Cannot reach SharePoint: '+err.message); });
      return;
    }
    if(!data||!data.d){
      clearTimeout(accessTimer);
      finishAccess(function(){ showDenied('Unexpected SharePoint response. Please refresh.'); });
      return;
    }
    USER.email=(data.d.Email||'').trim();
    USER.name=(data.d.Title||'User').trim();
    if(!USER.email){
      clearTimeout(accessTimer);
      finishAccess(function(){ showDenied('Could not read your SharePoint email.'); });
      return;
    }
    var safeEmail=USER.email.replace(/'/g,"''");
    spGet(SP_SITE+"/_api/web/lists/getbytitle('"+SP_ACCESS+"')/items?$select=UserEmailID,Role&$filter=UserEmailID eq '"+safeEmail+"'",function(err2,data2){
      clearTimeout(accessTimer);
      if(err2){
        finishAccess(function(){ showDenied('Access list error: '+err2.message); });
        return;
      }
      var results=(data2&&data2.d&&data2.d.results)?data2.d.results:[];
      if(!results.length){
        finishAccess(function(){ showDenied('You are not authorised. Contact tehleel.lone@du.ae'); });
        return;
      }
      var role=(results[0].Role||'').trim();
      var ALLOWED=['Admin','CEO','Head Director','Account Director','Account Manager','Viewer'];
      if(!ALLOWED.includes(role)){
        finishAccess(function(){ showDenied('Your role "'+role+'" has no access. Contact tehleel.lone@du.ae'); });
        return;
      }
      USER.role=role;
      console.log('[GLK] Role:', JSON.stringify(results[0]));
      finishAccess(populateLanding);
    });
  });
}
