.mq-control-step{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;background:var(--grad);color:#fff;font-size:.62rem;font-weight:800;flex-shrink:0}
.mq-control-label{font-size:.72rem;font-weight:800;color:var(--t1);text-transform:uppercase;letter-spacing:.04em}
