    if(!meta||!meta.data) return;
    meta.data.forEach(function(bar,i){
      var b=bars[i]; if(!b||b.value<=0) return;
      var top=Math.min(bar.y,bar.base),bot=Math.max(bar.y,bar.base),h=bot-top;
      var midY=top+h/2;
      ctx.save();
      if(h<14&&b.type==='step'){
        ctx.fillStyle=b.color||MQ_CLR_INFLIGHT[0];
        ctx.font='bold 9px Inter';
        ctx.textAlign='center';
        ctx.textBaseline='bottom';
        ctx.fillText(fmt(b.value),bar.x,top-3);
      }else{
        if(h<10) midY=top-8;
        ctx.fillStyle='#fff';
        ctx.font='bold 10px Inter';
        ctx.textAlign='center';
        ctx.textBaseline='middle';
        ctx.fillText(fmt(b.value),bar.x,midY);
