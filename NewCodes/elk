  let closureProb=rawProb;
  let status=rawStatus;
  if(forecastCategory&&FORECAST_TO_PROB[forecastCategory]) closureProb=FORECAST_TO_PROB[forecastCategory];
  if(forecastCategory&&FORECAST_TO_STATUS[forecastCategory]) status=FORECAST_TO_STATUS[forecastCategory];
  return {
    id:it.Id,customerName:it.Title||'—',typeOfRequest:it.Type_x0020_of_x0020_Request||'—',
    oppStatus:rawStatus||'—',
    typeOfContract:it.Type_x0020_of_x0020_Contract||'—',vertical:it.Segment||'—',
