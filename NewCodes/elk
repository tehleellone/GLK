const num = v => { const n=parseFloat(v); return isNaN(n)?0:n; };
function fmt(v){
  const n=num(v);
  if(n>=1e9) return (n/1e9).toFixed(2)+'B';
  if(n>=1e6) return (n/1e6).toFixed(2)+'M';
  if(n>=1e3) return (n/1e3).toFixed(1)+'K';
  return n.toFixed(0);
}
function fmtGA(v){ const n=num(v); return n%1===0?n.toFixed(0):n.toFixed(2); }
function fmtExportNum(v){ const n=num(v); return n%1===0?n.toFixed(0):n.toFixed(2); }
function fmtLines(v){ const n=num(v); if(isNaN(n)) return '—'; return Math.round(n).toLocaleString('en-US'); }
const fmtDate = iso => { if(!iso) return '—'; const d=new Date(iso); return isNaN(d)?'—':d.toLocaleDateString('en-GB'); };
  function fmtYearImpact(v) {
  if (v === null || v === undefined) return '—';
  if (v === 0) return 'AED 0';
  if (v >= 1e6) return 'AED ' + (v / 1e6).toFixed(2) + 'M';
  if (v >= 1e3) return 'AED ' + v.toLocaleString('en-US');
  return 'AED ' + v.toFixed(0);
}

function calcYearImpact(bid) {
  const STATUS_SKIP = ['Lost', 'Cancelled', 'No Bid'];
  if (STATUS_SKIP.includes(bid.status)) return { val: null, note: null };
  if (!bid.expectedActivation) return { val: null, note: null };
  const actDate = new Date(bid.expectedActivation);
  if (isNaN(actDate)) return { val: null, note: null };
  const currentYear = new Date().getFullYear();
  const actYear = actDate.getFullYear();
  if (actYear < currentYear) return { val: null, note: null };
  if (actYear > currentYear) return { val: null, note: 'Expected activation in ' + actYear + ' — cannot calculate this year' };
  const monthsRemaining = 12 - actDate.getMonth();
  const impact = bid.mrc * monthsRemaining;
  return { val: impact, note: null };
}
function getInitials(name){ if(!name) return '?'; const p=name.trim().split(' '); return p.length>=2?(p[0][0]+p[p.length-1][0]).toUpperCase():name[0].toUpperCase(); }
function getRelevantDate(bid){
  const s=bid.status;
  const fc=bid.forecastCategory;
  if(s==='Won'||fc==='Closed Won') return bid.contractSigned||bid.billedDate||bid.expectedActivation;
  if(s==='Billed') return bid.billedDate||bid.contractSigned;
  if(STATUS_IP.includes(s)) return bid.expectedActivation||bid.proposedDate;
  if(STATUS_LOST.includes(s)||fc==='Closed Lost') return bid.lostDate||bid.proposedDate;
  return bid.proposedDate||bid.contractSigned||bid.expectedActivation||bid.created;
}
function glkBidMetric(b,k){ return k==='mrc'?b.mrc:k==='tcv'?b.tcv:k==='otc'?b.otc:b.gaPoints; }
function glkFilterByChartPeriod(bids,period){
  var now=new Date();
  return (bids||[]).filter(function(b){
    var iso=getRelevantDate(b);
    if(!iso) return false;
    var d=new Date(iso);
    if(isNaN(d)) return false;
    if(period==='YTD') return d.getFullYear()===now.getFullYear()&&d<=now;
    if(period==='Y') return d.getFullYear()===now.getFullYear();
    if(period==='Q') return d.getFullYear()===now.getFullYear()&&Math.ceil((d.getMonth()+1)/3)===Math.ceil((now.getMonth()+1)/3);
    if(period==='M') return d.getFullYear()===now.getFullYear()&&d.getMonth()===now.getMonth();
    if(period==='W') return d.getFullYear()===now.getFullYear()&&getWeekOfYear(d)===getWeekOfYear(now);
    return true;
  });
}
