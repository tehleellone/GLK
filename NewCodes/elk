function mqDateOnly(d){
  return new Date(d.getFullYear(),d.getMonth(),d.getDate());
}
function mqParseBidDate(iso){
  if(!iso) return null;
  if(typeof iso==='string'){
    var s=iso.trim();
    var dm=/\/Date\((-?\d+)\)\//.exec(s);
    if(dm){ var d=new Date(+dm[1]); return isNaN(d)?null:mqDateOnly(d); }
    var slash=/^(\d{1,2})\/(\d{1,2})\/(\d{4})/.exec(s);
    if(slash){
      var p1=+slash[1], p2=+slash[2], y=+slash[3], month, day;
      if(p1>12){ day=p1; month=p2; }
      else if(p2>12){ month=p1; day=p2; }
      else { month=p1; day=p2; }
      var ld=new Date(y,month-1,day);
      return isNaN(ld)?null:mqDateOnly(ld);
    }
  }
  var d=new Date(iso);
  return isNaN(d)?null:mqDateOnly(d);
}
