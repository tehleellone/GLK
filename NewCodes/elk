function glkBridgeTop10Asc(bids,metric){
  var map={};
  (bids||[]).forEach(function(b){
    var k=b.customerName||'Unknown';
    map[k]=(map[k]||0)+glkBidMetric(b,metric);
  });
  var sorted=Object.keys(map).map(function(k){return [k,map[k]];}).filter(function(p){return p[1]>0;}).sort(function(a,b){return b[1]-a[1];});
  var top10=sorted.slice(0,10).sort(function(a,b){return a[1]-b[1];});
  var others=sorted.slice(10).reduce(function(s,p){return s+p[1];},0);
  return {items:top10.map(function(p){return {name:p[0],value:p[1]};}),others:others};
}
function glkBridgeCalc(bids,metric,targetVal,isBest){
  var scoped=glkBridgeScope(bids);
  var wonBilledVal=scoped.filter(function(b){return b.status==='Won'||b.status==='Billed';}).reduce(function(s,b){return s+glkBidMetric(b,metric);},0);
  var inForecastBids=scoped.filter(function(b){return b.status==='Proposed';});
  var top=glkBridgeTop10Asc(inForecastBids,metric);
  var top10Sum=top.items.reduce(function(s,p){return s+p.value;},0);
  var inForecastOthers=top.others;
  var outForecastVal=isBest?scoped.filter(function(b){return b.status==='Opportunity';}).reduce(function(s,b){return s+glkBidMetric(b,metric);},0):0;
  var total=wonBilledVal+top10Sum+inForecastOthers+outForecastVal;
  var gap=targetVal-total;
  return {scoped:scoped,wonBilledVal:wonBilledVal,top:top,top10Sum:top10Sum,inForecastOthers:inForecastOthers,outForecastVal:outForecastVal,total:total,gap:gap,over:gap<=0};
}
