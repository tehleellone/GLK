function glkFindFixedNetMrcCandidates(rows){
  var out=[];
  for(var r=0;r<rows.length;r++){
    var row=rows[r]||[];
    for(var c=0;c<row.length;c++){
      var raw=String(row[c]||'').trim();
      if(!raw) continue;
      var t=glkNormCellTxt(raw);
      var score=0;
      if(/fixed/.test(t)&&/net/.test(t)&&/mrc/.test(t)) score+=35;
      else if(/fixed/.test(t)&&/mrc/.test(t)) score+=22;
      if(/mobile/.test(t)) score-=25;
      if(/lines/.test(t)||/points/.test(t)||/adds/.test(t)) score-=18;
      if(/revenue trend|mrc trend|fixed gross/.test(t)) score-=20;
      if(c>40) score-=12;
      if(score>=20) out.push({row:r,col:c,title:raw,score:score});
    }
  }
  out.sort(function(a,b){
    if(b.score!==a.score) return b.score-a.score;
    if(a.col!==b.col) return a.col-b.col;
    return a.row-b.row;
  });
