let glkDateRules=[];
let glkCompareEnabled=false;
let glkCompareYear=String(new Date().getFullYear()-1);
let glkRuleSeq=0;

function glkDefaultDateRule(field){
  return {id:'r'+(glkRuleSeq++),dateField:field||'created',dateMode:'any',from:'',to:'',specific:'',ytdYear:'',years:[],quarters:[],months:[],weeks:[]};
}
function glkBidDateValue(bid,field){ return bid&&field?bid[field]||null:null; }
function glkWeekOfMonth(d){ if(!(d instanceof Date)||isNaN(d)) return null; return Math.ceil(d.getDate()/7); }
function glkDateMeta(iso){
  if(!iso) return null;
  const d=new Date(iso); if(isNaN(d)) return null;
  const y=d.getFullYear(),mi=d.getMonth();
  return {year:y,quarter:Math.floor(mi/3)+1,monthIndex:mi,week:glkWeekOfMonth(d),dayStart:new Date(y,mi,d.getDate()).getTime()};
}
function glkDateFieldLabel(key){ const o=GLK_DATE_FIELD_OPTS.find(x=>x.key===key); return o?o.label:key; }
function glkDateModeHint(mode){
  if(mode==='range') return 'Start and end date — both days included.';
  if(mode==='single') return 'Records on exactly one day.';
  if(mode==='period') return 'Combine year, quarter, month, week.';
  if(mode==='ytd') return '1 Jan through today for selected year.';
  return 'Choose a filter mode to activate this criterion.';
}
function glkRulePrefix(id){ return 'glkR_'+id; }
function glkGetSelectVal(id){ const e=el(id); return e?String(e.value||'').trim():''; }
function glkGetRuleChecked(ruleId,part){
  const drop=el(glkRulePrefix(ruleId)+'_'+part);
  if(!drop) return [];
  return Array.from(drop.querySelectorAll('input:checked')).map(c=>c.value);
}
function glkUpdateRuleMsText(ruleId,part,label){
  const checked=glkGetRuleChecked(ruleId,part);
  const te=el(glkRulePrefix(ruleId)+'_'+part+'Text'); if(!te) return;
  if(!checked.length){ te.textContent='All '+label; return; }
  if(checked.length===1){
    if(part==='quarter') te.textContent='Q'+checked[0];
    else if(part==='month') te.textContent=MONTH_NAMES[+checked[0]]||checked[0];
    else if(part==='week') te.textContent='W'+checked[0];
    else te.textContent=checked[0];
    return;
  }
  te.textContent=checked.length+' selected';
}
function glkToggleRuleMs(ruleId,part){
  const drop=el(glkRulePrefix(ruleId)+'_'+part),trig=el(glkRulePrefix(ruleId)+'_'+part+'Trig');
  if(!drop||!trig) return;
  const isOpen=drop.classList.contains('open');
  document.querySelectorAll('.glk-date-rule .ms-dropdown.open').forEach(d=>{d.classList.remove('open');if(d.previousElementSibling)d.previousElementSibling.classList.remove('open');});
  if(!isOpen){
    const rect=trig.getBoundingClientRect();
    drop.style.top=(rect.bottom+4)+'px';drop.style.left=rect.left+'px';
    drop.style.width=Math.max(rect.width,180)+'px';
    drop.classList.add('open');trig.classList.add('open');
  }
}
function glkBuildRuleMs(ruleId,part,label,values,selected,labelFn){
  const drop=el(glkRulePrefix(ruleId)+'_'+part); if(!drop) return;
  const selSet={}; (selected||[]).forEach(v=>{selSet[String(v)]=true;});
